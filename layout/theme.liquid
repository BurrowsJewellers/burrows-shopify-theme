<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta name="theme-color" content="{{ settings.color_navy }}">
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" sizes="32x32" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
      <link rel="icon" type="image/png" sizes="192x192" href="{{ settings.favicon | image_url: width: 192, height: 192 }}">
      <link rel="apple-touch-icon" sizes="180x180" href="{{ settings.favicon | image_url: width: 180, height: 180 }}">
    {%- endif -%}

    {% render 'meta-tags' %}
    {%- liquid
      comment
        Robots: everything public is indexable. noindex only for (a) hidden service products the ring
        builder creates, (b) the handles listed in Theme settings → SEO (test pages, supplier iframes),
        (c) on-site search results. Public products, collections, pages and posts never carry it.
      endcomment
      assign noindex = false
      if product.tags contains 'hidden-service'
        assign noindex = true
      endif
      if request.page_type == 'page' and settings.noindex_handles != blank
        assign nh = settings.noindex_handles | newline_to_br | split: '<br />'
        for h in nh
          assign hh = h | strip
          if hh != blank and hh == page.handle
            assign noindex = true
          endif
        endfor
      endif
      if request.page_type == 'search' and settings.noindex_search
        assign noindex = true
      endif
    -%}
    {%- if noindex -%}<meta name="robots" content="noindex, follow">{%- endif -%}
    {% render 'integrations-head' %}

    {%- if settings.google_fonts_url != blank -%}
      <link rel="preconnect" href="https://fonts.googleapis.com">
      <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
      {%- comment -%} Fonts load without blocking first paint (the URL carries display=swap); the fallback font shows until they arrive. {%- endcomment -%}
      <link rel="preload" as="style" href="{{ settings.google_fonts_url }}" onload="this.onload=null;this.rel='stylesheet'">
      <noscript><link href="{{ settings.google_fonts_url }}" rel="stylesheet"></noscript>
    {%- endif -%}

    {% render 'css-variables' %}
    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {%- if template.suffix contains 'ring-builder' -%}
      {%- comment -%} The builder's stylesheet used to arrive after the section had painted unstyled — a full-page layout shift on phones. {%- endcomment -%}
      {{ 'ring-builder.css' | asset_url | stylesheet_tag }}
    {%- endif -%}

    {{ content_for_header }}
  </head>

  {%- liquid
    assign body_class = 'template-' | append: template.name
    if template.suffix != blank
      assign body_class = body_class | append: ' template-' | append: template.name | append: '-' | append: template.suffix
    endif
    if template.name == 'index'
      assign body_class = body_class | append: ' has-transparent-header'
    endif
    assign shop_templates = 'collection,product,search,cart,list-collections' | split: ','
    if settings.shop_background == 'white' and shop_templates contains template.name
      assign body_class = body_class | append: ' shop-white'
    endif
  -%}
  <body class="{{ body_class }}">
    <a class="skip-link" href="#MainContent">Skip to content</a>

    {% sections 'header-group' %}

    <main id="MainContent" class="main-content" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    <script src="{{ 'theme.js' | asset_url }}" defer></script>
    {% render 'integrations-body' %}
  </body>
</html>
