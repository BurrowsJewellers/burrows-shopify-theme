<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    {% render 'css-variables' %}
    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {%- if settings.google_fonts_url != blank -%}<link href="{{ settings.google_fonts_url }}" rel="stylesheet">{%- endif -%}
    {% render 'meta-tags' %}
    {{ content_for_header }}
  </head>

  <body>
    {{ content_for_layout }}
  </body>
</html>
