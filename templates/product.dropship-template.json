{
  "sections": {
    "main": {
      "type": "main-product",
      "blocks": {
        "title": {
          "type": "title",
          "settings": {
            "show_vendor": true
          }
        },
        "price": {
          "type": "price",
          "settings": {
            "gst_note": "AUD · incl. GST",
            "show_afterpay": true,
            "show_design_number": true
          }
        },
        "note": {
          "type": "text",
          "settings": {
            "text": "<p><strong>Ships from our warehouse. Allow up to 2 business days before dispatch.</strong></p>"
          }
        },
        "variants": {
          "type": "variant_picker",
          "settings": {
            "size_note": "Not sure of your size? Ask us and we'll help."
          }
        },
        "buy": {
          "type": "buy_buttons",
          "settings": {
            "label": "Add to cart",
            "show_quantity": true,
            "show_dynamic_checkout": false
          }
        },
        "booking": {
          "type": "booking",
          "settings": {
            "label": "Book a viewing in store"
          }
        },
        "contact": {
          "type": "contact_link",
          "settings": {
            "label": "Contact us about this piece",
            "url": "shopify://pages/contact"
          }
        },
        "strip": {
          "type": "trust_strip",
          "settings": {
            "item_1": "Free AU shipping over $99",
            "item_2": "Custom design and remodelling",
            "item_3": "Cleaning, resizing and repairs",
            "item_4": "Afterpay and Zip available"
          }
        },
        "desc": {
          "type": "description",
          "settings": {
            "heading": "Description",
            "open": true
          }
        },
        "specs": {
          "type": "specs",
          "settings": {
            "heading": "Specifications"
          }
        },
        "ship": {
          "type": "accordion",
          "settings": {
            "heading": "Shipping details",
            "text": "<ul><li>We ship within Australia only.</li><li>Orders over $99 ship free. Orders over $250 ship free by express. Orders under $99 have a $5 shipping fee.</li><li>Most orders leave within 1–3 business days. If yours is delayed we will call or email you. <a href=\"/pages/shipping-and-returns\">Shipping and returns policy</a>.</li></ul>"
          }
        },
        "work": {
          "type": "accordion",
          "settings": {
            "heading": "Care and aftercare",
            "text": "<p>Cleaning, checks, resizing and repairs are arranged in store whenever the piece needs them. Bring it back any time.</p>"
          }
        },
        "panel": {
          "type": "workshop",
          "settings": {
            "heading": "Bring it back any time",
            "text": "Cleaning, checks, resizing, repairs and remodelling are all arranged at 68 Langtree Ave, Mildura."
          }
        },
        "sizing": {
          "type": "ring_sizing",
          "settings": {
            "resize_product": "ring-resizing",
            "prefixes": "001,002,004",
            "steps": 2,
            "contact_url": "shopify://pages/contact"
          }
        },
        "pickup": {
          "type": "pickup",
          "settings": {}
        }
      },
      "block_order": [
        "title",
        "price",
        "note",
        "variants",
        "sizing",
        "buy",
        "pickup",
        "booking",
        "contact",
        "strip",
        "desc",
        "specs",
        "ship",
        "work",
        "panel"
      ],
      "settings": {
        "show_breadcrumbs": true,
        "show_sticky": true
      }
    },
    "recommendations": {
      "type": "product-recommendations",
      "settings": {
        "heading": "You may also like",
        "limit": 4,
        "background": "cream"
      }
    }
  },
  "order": [
    "main",
    "recommendations"
  ]
}
