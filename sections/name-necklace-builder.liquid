{%- comment -%}
  Burrows Name Necklace Builder. Five sections, one open at a time: 1 name · 2 style · 3 metal · 4 chain · 5 review.
  A price bar under them always shows the running total and Add to cart.

  The designer runs in the browser (assets/name-necklace-core.js, generated from the name-necklace-builder repo)
  and asks the name necklace API for prices. The stage shows the necklace to scale on a neck (a close-up of
  the plate is rendered off screen only for the order picture). There is no letter editor: i/j dots, accents and stray strokes join their letter by
  themselves, thin strokes are reinforced to the casting minimum by themselves, and a name is one word.
  Add to cart posts the design to {{ api_base }}/build, which rebuilds it, writes the casting STL and makes a
  hidden Shopify product at the quoted price; the theme adds that variant to the cart with the design details as
  line item properties.

  Staff mode: the dashboard's Custom Orders tab opens this page with ?build=<id>&t=<token>. The paid design loads
  from the API, the stage gains a "Letters" view (move, turn, scale single letters), every thickness is offered,
  Review shows the cost figures, and the price bar's button sends the revised design back to the dashboard
  (postMessage) instead of adding to the cart. All of it is built by name-necklace.js; nothing here changes.

  Script order matters. The geometry core looks for opentype.js, clipper-lib and earcut the moment it runs, so
  those three load (deferred, in order) before it. three.js is fetched by name-necklace.js only when the page is
  up, for the order picture; until then the (hidden) close-up is drawn as a flat metal shape.

  Fonts come from {{ fonts_base }}/<file> (served by the API with CORS), so nothing heavy is inlined here.
{%- endcomment -%}
{%- assign s = section.settings -%}
{%- assign api_base = s.api_base | strip | default: 'https://dashboard.burrowsjewellers.com.au/name-necklace/api' -%}
{%- assign fonts_base = s.fonts_base | strip | default: 'https://dashboard.burrowsjewellers.com.au/name-necklace/fonts' -%}
{{ 'name-necklace.css' | asset_url | stylesheet_tag }}
<section class="full-width nn" id="nameNecklace" data-name-necklace>
  <div class="nn__inner">
    <header class="nn__head">
      {%- if s.eyebrow != blank -%}<div class="eyebrow">{{ s.eyebrow }}</div>{%- endif -%}
      <h1 class="nn__title">{{ s.heading }}</h1>
      {%- if s.intro != blank -%}<p class="nn__intro lede">{{ s.intro }}</p>{%- endif -%}
      <ol class="nn__steps" data-nn-steps aria-label="Steps">
        <li data-step="1" class="on"><button type="button" aria-controls="nnBody1"><span>1</span>Name</button></li>
        <li data-step="2"><button type="button" aria-controls="nnBody2"><span>2</span>Style</button></li>
        <li data-step="3"><button type="button" aria-controls="nnBody3"><span>3</span>Metal</button></li>
        <li data-step="4"><button type="button" aria-controls="nnBody4"><span>4</span>Chain</button></li>
        <li data-step="5"><button type="button" aria-controls="nnBody5"><span>5</span>Review</button></li>
      </ol>
    </header>

    <div class="nn__app" data-nn-app aria-busy="true">
      <div class="nn__loading" id="loading"><span class="nn__spin"></span>Loading the designer…</div>

      <div class="nn__stage" id="stage">
        <div class="nn__size" id="sizeView">
          <svg class="nn__size-svg" id="sizeSvg" role="img" aria-label="The necklace shown to scale on a neck"></svg>
        </div>
        <div class="nn__hud nn__hud--top">
          <div class="nn__hud-left">
            <span class="nn__hint" id="hint">Shown to scale</span>
            <button type="button" class="nn__mini" id="undoBtn" title="Undo (Ctrl+Z)" disabled>Undo</button>
          </div>
          <div class="nn__hud-right">
            <span class="nn__stage-price" id="stagePrice" aria-live="polite"></span>
          </div>
        </div>
        {%- comment -%} The close-up is not shown (the photo is the preview), but the figure stays as the home of the
            WebGL canvas that renders the order picture sent with each build, and of the dimensions readout. {%- endcomment -%}
        <figure class="nn__closeup" id="closeup" aria-hidden="true">
          <div class="nn__closeup-view" id="closeupView">
            <svg class="nn__closeup-svg" id="closeupSvg" role="img" aria-label="Close-up of the nameplate"></svg>
          </div>
          <figcaption class="nn__closeup-cap"><span>Close-up</span><span id="dims"></span></figcaption>
        </figure>
        <div class="nn__hud nn__hud--bottom">
          <div class="nn__sizebar" id="sizeBar"></div>
        </div>
      </div>

      <form class="nn__panel" id="controls" autocomplete="off" novalidate>
        <div class="nn__block is-open" data-block="1">
          <h2 class="nn__h"><button type="button" class="nn__h-btn" id="nnHead1" aria-expanded="true" aria-controls="nnBody1"><span class="nn__h-n">1</span><span class="nn__h-t">Name</span><span class="nn__h-v" data-choice></span><i class="nn__h-c" aria-hidden="true"></i></button></h2>
          <div class="nn__body" id="nnBody1" role="region" aria-labelledby="nnHead1">
            <div class="nn__group">
              <label class="nn__label" for="nameIn">The name</label>
              <div class="nn__namefield">
                <input type="text" id="nameIn" class="nn__text" maxlength="14" spellcheck="false" autocapitalize="words" value="Charlotte">
                <span class="nn__counter" id="counter" aria-live="polite">9/14</span>
              </div>
              <p class="nn__warn" id="nameWarn" role="alert" hidden></p>
              <p class="nn__note">One word, up to 14 characters. The letters join into one solid piece, so it casts and wears well.</p>
            </div>
            <button type="button" class="nn__next" data-next="2">Next: Style</button>
          </div>
        </div>

        <div class="nn__block" data-block="2">
          <h2 class="nn__h"><button type="button" class="nn__h-btn" id="nnHead2" aria-expanded="false" aria-controls="nnBody2"><span class="nn__h-n">2</span><span class="nn__h-t">Style</span><span class="nn__h-v" data-choice></span><i class="nn__h-c" aria-hidden="true"></i></button></h2>
          <div class="nn__body" id="nnBody2" role="region" aria-labelledby="nnHead2" hidden>
            <fieldset class="nn__group">
              <legend class="nn__label">Font</legend>
              <div class="nn__font-list" id="fontList"></div>
            </fieldset>

            <fieldset class="nn__group">
              <legend class="nn__label">Height</legend>
              <div class="nn__seg" id="heightSeg">
                <label><input type="radio" name="height" value="small"><span>Small 8</span></label>
                <label><input type="radio" name="height" value="medium" checked><span>Medium 12</span></label>
                <label><input type="radio" name="height" value="large"><span>Large 16</span></label>
                <label><input type="radio" name="height" value="custom"><span>Custom</span></label>
              </div>
              <div class="nn__row" id="heightRow" hidden>
                <input type="number" id="heightIn" class="nn__num" min="6" max="25" step="0.5" value="12" aria-label="Height in millimetres">
                <span class="nn__unit">mm</span>
                <span class="nn__readout">custom 6 to 25 mm</span>
              </div>
            </fieldset>

            <div class="nn__group">
              <label class="nn__label" for="curveRange">Curve</label>
              <div class="nn__slider">
                <input type="range" id="curveRange" min="0" max="180" step="5" value="70" list="curveTicks">
                <input type="number" id="curveIn" class="nn__num" min="0" max="180" step="5" value="70" aria-label="Curve in degrees of arc">
                <span class="nn__unit">°</span>
              </div>
              <datalist id="curveTicks"><option value="0"></option><option value="70"></option></datalist>
              <p class="nn__readout" id="curveReadout"><b>70°</b></p>
              <p class="nn__note">Bends the name along an arc so the ends lift as it hangs on the chain. 0 is flat.</p>
            </div>

            <fieldset class="nn__group">
              <legend class="nn__label">Thickness</legend>
              <div class="nn__seg" id="thickSeg"></div>
            </fieldset>

            <details class="nn__more" id="paneAdvanced">
              <summary class="nn__label">More options<span class="nn__pm" aria-hidden="true"></span></summary>
              <div class="nn__more-body">
                <fieldset class="nn__group">
                  <legend class="nn__label">Finish</legend>
                  <div class="nn__seg">
                    <label><input type="radio" name="finish" value="polished" checked><span>Polished</span></label>
                    <label><input type="radio" name="finish" value="brushed"><span>Brushed</span></label>
                    <label><input type="radio" name="finish" value="satin"><span>Satin</span></label>
                  </div>
                  {%- if s.finish_note != blank -%}<p class="nn__note">{{ s.finish_note }}</p>{%- endif -%}
                </fieldset>

                <div class="nn__group">
                  <label class="nn__label" for="ovRange">Letter overlap</label>
                  <div class="nn__slider">
                    <input type="range" id="ovRange" min="0.1" max="1" step="0.05" value="0.3">
                    <input type="number" id="ovIn" class="nn__num" min="0.1" max="1" step="0.05" value="0.30" aria-label="Overlap in millimetres">
                    <span class="nn__unit">mm</span>
                  </div>
                  <p class="nn__note">How far each letter overlaps the one before it, at their closest point.</p>
                </div>

                <fieldset class="nn__group">
                  <legend class="nn__label">Chain loops</legend>
                  <div class="nn__seg">
                    <label><input type="checkbox" id="loopL" checked><span>Left loop</span></label>
                    <label><input type="checkbox" id="loopR" checked><span>Right loop</span></label>
                  </div>
                  <div class="nn__pair">
                    <label for="loopOuter">Outer Ø</label>
                    <input type="number" id="loopOuter" class="nn__num" min="2.5" max="5" step="0.1" value="3.2">
                    <span class="nn__unit">mm</span>
                    <label for="loopHole">Hole Ø</label>
                    <input type="number" id="loopHole" class="nn__num" min="1" max="2.5" step="0.1" value="1.4">
                    <span class="nn__unit">mm</span>
                  </div>
                  <p class="nn__warn" id="loopWarn" role="alert" hidden></p>
                </fieldset>

                <fieldset class="nn__group">
                  <legend class="nn__label">Dots on i and j</legend>
                  <div class="nn__seg">
                    <label><input type="radio" name="dots" value="keep" checked><span>Keep</span></label>
                    <label><input type="radio" name="dots" value="remove"><span>Remove</span></label>
                  </div>
                  <p class="nn__note">A kept dot is joined onto its letter so it can't come off.</p>
                </fieldset>

                {%- if s.show_stl -%}
                <fieldset class="nn__group">
                  <legend class="nn__label">Mesh detail (testing)</legend>
                  <div class="nn__seg">
                    <label><input type="radio" name="detail" value="draft"><span>Draft</span></label>
                    <label><input type="radio" name="detail" value="standard" checked><span>Standard</span></label>
                    <label><input type="radio" name="detail" value="fine"><span>Fine</span></label>
                  </div>
                </fieldset>
                <fieldset class="nn__group">
                  <legend class="nn__label">STL format (testing)</legend>
                  <div class="nn__seg">
                    <label><input type="radio" name="format" value="binary" checked><span>Binary</span></label>
                    <label><input type="radio" name="format" value="ascii"><span>ASCII text</span></label>
                  </div>
                </fieldset>
                {%- endif -%}
              </div>
            </details>
            <button type="button" class="nn__next" data-next="3">Next: Metal</button>
          </div>
        </div>

        <div class="nn__block" data-block="3">
          <h2 class="nn__h"><button type="button" class="nn__h-btn" id="nnHead3" aria-expanded="false" aria-controls="nnBody3"><span class="nn__h-n">3</span><span class="nn__h-t">Metal</span><span class="nn__h-v" data-choice></span><i class="nn__h-c" aria-hidden="true"></i></button></h2>
          <div class="nn__body" id="nnBody3" role="region" aria-labelledby="nnHead3" hidden>
            <div class="nn__group">
              <div class="nn__alloys" id="alloyChips" role="radiogroup" aria-label="Metal"></div>
              <p class="nn__note" id="weightLine"></p>
            </div>
            <button type="button" class="nn__next" data-next="4">Next: Chain</button>
          </div>
        </div>

        <div class="nn__block" data-block="4">
          <h2 class="nn__h"><button type="button" class="nn__h-btn" id="nnHead4" aria-expanded="false" aria-controls="nnBody4"><span class="nn__h-n">4</span><span class="nn__h-t">Chain</span><span class="nn__h-v" data-choice></span><i class="nn__h-c" aria-hidden="true"></i></button></h2>
          <div class="nn__body" id="nnBody4" role="region" aria-labelledby="nnHead4" hidden>
            <fieldset class="nn__group">
              <legend class="nn__label">Chain style</legend>
              <div class="nn__chain-tiles" id="chainStyles" role="radiogroup" aria-label="Chain style"></div>
            </fieldset>
            <fieldset class="nn__group">
              <legend class="nn__label">Chain thickness</legend>
              <div class="nn__chips nn__chips--gauge" id="chainGauges" role="radiogroup" aria-label="Chain thickness"></div>
              <p class="nn__note">Every necklace comes with its chain. Each price is the whole necklace with that chain.</p>
            </fieldset>
            <fieldset class="nn__group">
              <legend class="nn__label">Chain length</legend>
              <div class="nn__chips" id="chainLengths" role="radiogroup" aria-label="Chain length"></div>
              <p class="nn__note">40 cm sits at the base of the neck, 45 cm just below the collarbones, 50 cm a little lower. See it on the neck above.</p>
            </fieldset>
            <div class="nn__group">
              <span class="nn__label">Chain metal</span>
              <div class="nn__alloys" id="chainAlloyChips"></div>
            </div>
            <button type="button" class="nn__next" data-next="5">Next: Review</button>
          </div>
        </div>

        <div class="nn__block nn__block--review" data-block="5">
          <h2 class="nn__h"><button type="button" class="nn__h-btn" id="nnHead5" aria-expanded="false" aria-controls="nnBody5"><span class="nn__h-n">5</span><span class="nn__h-t">Review</span><span class="nn__h-v" data-choice></span><i class="nn__h-c" aria-hidden="true"></i></button></h2>
          <div class="nn__body" id="nnBody5" role="region" aria-labelledby="nnHead5" hidden>
            <div class="nn__summary" id="summary"></div>
            <div class="nn__total">
              <span class="nn__label">Price · AUD incl. GST</span>
              <p class="nn__price" id="priceOut" aria-live="polite"></p>
            </div>
            {%- if s.lead_time != blank -%}<p class="nn__note nn__note--ok">{{ s.lead_time }}</p>{%- endif -%}
            <p class="nn__note nn__note--ok" id="reinforceNote" hidden>Thin joints strengthened to 0.6 mm for casting.</p>
            {%- if s.proof_note != blank -%}<p class="nn__note nn__note--proof">{{ s.proof_note }}</p>{%- endif -%}
            <p class="nn__warn" id="looseWarn" hidden></p>
            <p class="nn__warn" id="thinWarn" hidden></p>
            {%- if settings.booking_url != blank -%}
            <div class="nn__actions">
              <a class="btn btn--outline-dark btn--lg" href="{{ settings.booking_url }}" target="_blank" rel="noopener">{{ s.booking_label | default: 'Book a consultation' }}</a>
            </div>
            {%- endif -%}
            <p class="nn__note" id="enquiry"><a class="nn__link" id="enquiryLink" href="{{ s.contact_url | default: '/pages/contact' }}">Prefer to ask us about it first? Send an enquiry</a>{%- if settings.store_phone_display != blank %} or call {{ settings.store_phone_display }}.{%- endif -%}</p>
            {%- if s.show_stl -%}
            <div class="nn__stl" id="stlTools">
              <div class="nn__label">Testing tools</div>
              <div class="nn__row">
                <button type="button" class="btn btn--outline-dark" id="saveBtn">Download STL</button>
                <button type="button" class="nn__linkbtn" id="copyJson">Copy design JSON</button>
              </div>
              <div class="nn__confirm" id="saveConfirm" hidden>
                <div class="nn__row">
                  <button type="button" class="nn__mini nn__mini--solid" id="saveAnyway">Save anyway</button>
                  <button type="button" class="nn__mini" id="saveCancel">Cancel</button>
                </div>
              </div>
              <p class="nn__readout" id="stats"></p>
            </div>
            {%- endif -%}
          </div>
        </div>

        <div class="nn__bar" id="priceBar">
          <div class="nn__bar-row">
            <div class="nn__bar-total">
              <span class="nn__bar-l">Total incl. GST</span>
              <span class="nn__bar-price" id="barPrice" aria-live="polite"></span>
            </div>
            <button type="submit" class="btn btn--gold" id="addBtn" disabled>Add to cart</button>
          </div>
          <p class="nn__status" id="status" role="status" aria-live="polite"></p>
        </div>
      </form>
    </div>
    <noscript><p class="nn__intro">The name necklace designer needs JavaScript. Call us on {{ settings.store_phone_display }} and we will design it with you.</p></noscript>
  </div>
  <script type="application/json" data-nn-config>
    {
      "apiBase": {{ api_base | json }},
      "fontsBase": {{ fonts_base | json }},
      "coreUrl": {{ 'name-necklace-core.js' | asset_url | json }},
      "cartEnabled": {{ s.cart_enabled }},
      "showStl": {{ s.show_stl }},
      "defaultAlloy": {{ s.default_alloy | default: 'ag925' | json }},
      "leadTime": {{ s.lead_time | json }},
      "contactUrl": {{ s.contact_url | default: '/pages/contact' | json }},
      "bookingUrl": {{ settings.booking_url | json }},
      "bookingLabel": {{ s.booking_label | json }},
      "phone": {{ settings.store_phone_display | json }},
      "finishNote": {{ s.finish_note | json }},
      "neckImage": {% if s.neck_image %}{{ s.neck_image | image_url: width: 1600 | json }}{% else %}null{% endif %},
      "neck": { "widthMm": {{ s.neck_width_mm | default: 105 }}, "left": [{{ s.neck_left_x | default: 35 }}, {{ s.neck_left_y | default: 38 }}], "right": [{{ s.neck_right_x | default: 65 }}, {{ s.neck_right_y | default: 38 }}], "notch": [{{ s.neck_notch_x | default: 50 }}, {{ s.neck_notch_y | default: 52 }}] }
    }
  </script>
</section>
<script src="https://cdn.jsdelivr.net/npm/opentype.js@1.3.4/dist/opentype.min.js" defer></script>
<script src="https://cdn.jsdelivr.net/npm/clipper-lib@6.4.2/clipper.js" defer></script>
<script src="https://cdn.jsdelivr.net/npm/earcut@2.2.4/dist/earcut.min.js" defer></script>
<script src="{{ 'name-necklace-core.js' | asset_url }}" defer></script>
<script src="{{ 'name-necklace.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Name necklace builder",
  "tag": "section",
  "class": "section-name-necklace",
  "limit": 1,
  "settings": [
    { "type": "header", "content": "Copy" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Made in our workshop" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Design your name necklace" },
    { "type": "textarea", "id": "intro", "label": "Intro", "default": "Type a name, pick a font, a metal and a chain, and see it to scale. Each piece is cast from your design and finished by hand in Mildura." },
    { "type": "text", "id": "lead_time", "label": "Lead time line", "default": "Made to order · about 3 weeks" },
    { "type": "textarea", "id": "proof_note", "label": "Proof note (under the price)", "default": "Our jeweller will manually review your design to ensure structural integrity. Prior to production, we will email you a proof for your review and approval within 24 hours. If you don't receive a proof within 24 hours, please call us on 03 5023 2357." },
    { "type": "text", "id": "finish_note", "label": "Finish note", "default": "Polished, brushed or satin. Done by hand after casting." },

    { "type": "header", "content": "Name necklace API" },
    { "type": "text", "id": "api_base", "label": "API base URL", "default": "https://dashboard.burrowsjewellers.com.au/name-necklace/api" },
    { "type": "text", "id": "fonts_base", "label": "Fonts base URL", "default": "https://dashboard.burrowsjewellers.com.au/name-necklace/fonts" },
    { "type": "select", "id": "default_alloy", "label": "Default metal", "default": "ag925", "options": [
      { "value": "ag925", "label": "Sterling silver" },
      { "value": "9y", "label": "9ct yellow gold" },
      { "value": "9w", "label": "9ct white gold" },
      { "value": "9r", "label": "9ct rose gold" },
      { "value": "14y", "label": "14ct yellow gold" },
      { "value": "14w", "label": "14ct white gold" },
      { "value": "14r", "label": "14ct rose gold" },
      { "value": "18y", "label": "18ct yellow gold" },
      { "value": "18w", "label": "18ct white gold" },
      { "value": "18r", "label": "18ct rose gold" },
      { "value": "pt950", "label": "Platinum 950" }
    ] },

    { "type": "header", "content": "On a neck photo" },
    { "type": "image_picker", "id": "neck_image", "label": "Neck photo", "info": "Front-on, shoulders and collarbones visible, no jewellery. Leave empty for the line drawing." },
    { "type": "number", "id": "neck_width_mm", "label": "Real distance between the two chain points (mm)", "default": 105, "info": "Where the chain comes over each shoulder, as it would be measured on the person." },
    { "type": "number", "id": "neck_left_x", "label": "Left chain point, x (% of photo width)", "default": 35 },
    { "type": "number", "id": "neck_left_y", "label": "Left chain point, y (% of photo height)", "default": 38 },
    { "type": "number", "id": "neck_right_x", "label": "Right chain point, x (%)", "default": 65 },
    { "type": "number", "id": "neck_right_y", "label": "Right chain point, y (%)", "default": 38 },
    { "type": "number", "id": "neck_notch_x", "label": "Collarbone notch, x (%)", "default": 50 },
    { "type": "number", "id": "neck_notch_y", "label": "Collarbone notch, y (%)", "default": 52 },

    { "type": "header", "content": "Review step" },
    { "type": "checkbox", "id": "cart_enabled", "label": "Add to cart", "default": true, "info": "Shows Add to cart when the API has its Shopify credentials; otherwise customers send an enquiry." },
    { "type": "checkbox", "id": "show_stl", "label": "Show STL download and design JSON (testing)", "default": false },
    { "type": "url", "id": "contact_url", "label": "Enquiry link", "info": "Defaults to the contact page" },
    { "type": "text", "id": "booking_label", "label": "Booking button label", "default": "Book a consultation" }
  ],
  "presets": [ { "name": "Name necklace builder" } ]
}
{% endschema %}
