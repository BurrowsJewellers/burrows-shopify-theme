{%- assign s = section.settings -%}
<section class="full-width hero on-dark" style="--hero-h: {{ s.height }}px" data-hero>
  {% render 'bg-image', image: s.image, fallback: s.image_url, alt: s.image_alt, parallax: 0.22, width: 1920, loading: 'eager' %}
  <div class="hero__shade"></div>
  <div class="hero__copy">
    {%- if s.eyebrow != blank -%}<div class="eyebrow eyebrow--light hero__eyebrow">{{ s.eyebrow }}</div>{%- endif -%}
    {%- if s.heading != blank -%}<h1 class="h1">{{ s.heading }}</h1>{%- endif -%}
    {%- if s.text != blank -%}<p class="hero__text">{{ s.text }}</p>{%- endif -%}
    <div class="actions actions--tight">
      {%- if s.btn1_label != blank -%}<a class="btn btn--gold btn--lg" href="{{ s.btn1_url | default: '#' }}">{{ s.btn1_label }}</a>{%- endif -%}
      {%- if s.btn2_label != blank -%}<a class="btn btn--outline-light btn--lg" href="{{ s.btn2_url | default: settings.booking_url }}">{{ s.btn2_label }}</a>{%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .hero { position: relative; height: var(--hero-h, 780px); min-height: 560px; background: var(--navy-3); overflow: hidden; }
  .hero .cover, .hero .parallax { position: absolute; }
  .hero .cover { inset: 0; }
  .hero .cover img, .hero .parallax img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .hero__shade { position: absolute; inset: 0; background: linear-gradient(to top, rgba(var(--navy-rgb), .69) 0%, rgba(var(--navy-rgb), .25) 45%, rgba(var(--navy-rgb), .39) 100%); pointer-events: none; }
  .hero__copy { position: relative; z-index: 2; height: 100%; display: flex; flex-direction: column; justify-content: flex-end; padding: 0 var(--gutter) 96px; max-width: 760px; }
  .hero__eyebrow { margin-bottom: 20px; }
  .hero__copy h1 { margin: 0 0 22px; }
  .hero__text { font-size: 18px; line-height: 1.6; color: rgba(var(--cream-rgb), .85); margin: 0 0 36px; max-width: 520px; font-weight: 300; }
  @media (max-width: 1023px) {
    .hero { height: auto; min-height: 640px; }
    .hero__copy { padding: 140px var(--gutter-mobile) 64px; }
    .hero__text { font-size: 16px; }
    .hero .actions { flex-direction: column; align-items: stretch; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image" },
    { "type": "text", "id": "image_url", "label": "Image URL fallback", "default": "https://images.unsplash.com/photo-1607703829739-c05b7beddf60?fm=jpg&q=75&w=1920&auto=format&fit=crop", "info": "Placeholder until you choose an image above." },
    { "type": "text", "id": "image_alt", "label": "Image description (alt)", "default": "Engagement ring on dark velvet" },
    { "type": "range", "id": "height", "label": "Height (desktop)", "min": 560, "max": 960, "step": 20, "unit": "px", "default": 780 },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Engagement · Handcrafted in Mildura" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Creating forever moments" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Engagement rings designed with you and made in our Langtree Avenue workshop — one at a time, for one person." },
    { "type": "text", "id": "btn1_label", "label": "Primary button", "default": "Explore Engagement Rings" },
    { "type": "url", "id": "btn1_url", "label": "Primary button link" },
    { "type": "text", "id": "btn2_label", "label": "Secondary button", "default": "Book a Consultation" },
    { "type": "url", "id": "btn2_url", "label": "Secondary button link", "info": "Leave empty to use the booking URL from Theme settings." }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
