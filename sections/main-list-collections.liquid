<section class="full-width lc">
  <div class="page-hero">
    <h1>{{ section.settings.heading }}</h1>
    <div class="page-hero__diamond"></div>
  </div>
  <div class="lc__grid">
    {%- paginate collections by 24 -%}
      {%- for collection in collections -%}
        {%- if collection.products_count > 0 -%}
          <a class="lc__card" href="{{ collection.url }}">
            <div class="lc__media">
              {%- if collection.featured_image -%}
                {{ collection.featured_image | image_url: width: 700 | image_tag: loading: 'lazy', alt: collection.title }}
              {%- else -%}
                {{ 'collection-2' | placeholder_svg_tag: 'placeholder' }}
              {%- endif -%}
            </div>
            <div class="lc__cap"><span class="lc__name">{{ collection.title }}</span><span class="lc__cta">Shop &rarr;</span></div>
          </a>
        {%- endif -%}
      {%- endfor -%}
      {%- render 'pagination', paginate: paginate -%}
    {%- endpaginate -%}
  </div>
</section>

{% stylesheet %}
  .lc { background: var(--cream); }
  .lc__grid { max-width: var(--page-max); margin: 0 auto; padding: 0 var(--gutter) var(--section-pad); display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; }
  .lc__grid .pagination { grid-column: 1 / -1; }
  .lc__card { position: relative; display: block; aspect-ratio: 1; overflow: hidden; background: var(--navy-3); }
  .lc__media img, .lc__media svg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform .5s; }
  .lc__card:hover img { transform: scale(1.04); }
  .lc__cap { position: absolute; left: 0; right: 0; bottom: 0; padding: 50px 20px 18px; background: linear-gradient(transparent, rgba(var(--navy-rgb), .72)); display: flex; align-items: baseline; justify-content: space-between; gap: 10px; }
  .lc__name { font-family: var(--font-heading); font-size: 24px; color: var(--cream); }
  .lc__cta { font-size: 12px; letter-spacing: .12em; text-transform: uppercase; color: var(--gold-2); white-space: nowrap; }
  @media (max-width: 1023px) { .lc__grid { grid-template-columns: repeat(2, 1fr); gap: 12px; } .lc__name { font-size: 20px; } }
{% endstylesheet %}

{% schema %}
{
  "name": "Collections list",
  "settings": [ { "type": "text", "id": "heading", "label": "Heading", "default": "All collections" } ]
}
{% endschema %}
