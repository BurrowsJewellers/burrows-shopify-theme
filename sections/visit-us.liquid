{%- assign s = section.settings -%}
<section class="full-width split visit bg-cream" id="visit">
  <div class="split__copy">
    {%- if s.eyebrow != blank -%}<div class="eyebrow visit__eyebrow">{{ s.eyebrow }}</div>{%- endif -%}
    <h2 class="h2 visit__heading">{{ s.heading | default: settings.store_address_line }}</h2>
    <dl class="visit__facts">
      {%- for block in section.blocks -%}
        <dt {{ block.shopify_attributes }}>{{ block.settings.label }}</dt>
        <dd>{{ block.settings.value }}</dd>
      {%- endfor -%}
      {%- if s.show_phone and settings.store_phone_display != blank -%}
        <dt>Phone</dt>
        <dd><a class="visit__phone" href="tel:{{ settings.store_phone_tel }}">{{ settings.store_phone_display }}</a></dd>
      {%- endif -%}
    </dl>
    <div class="actions actions--tight">
      {%- if s.book_label != blank and settings.booking_url != blank -%}
        <a class="btn btn--gold btn--lg" href="{{ settings.booking_url }}" target="_blank" rel="noopener">{{ s.book_label }}</a>
      {%- endif -%}
      {%- if s.directions_label != blank and settings.directions_url != blank -%}
        <a class="btn btn--outline-dark btn--lg" href="{{ settings.directions_url }}" target="_blank" rel="noopener">{{ s.directions_label }}</a>
      {%- endif -%}
    </div>
  </div>
  <div class="visit__map">
    {%- if settings.map_embed_url != blank -%}
      <iframe src="{{ settings.map_embed_url }}" loading="lazy" title="{{ shop.name }} — {{ settings.store_address_line }}" referrerpolicy="no-referrer-when-downgrade"></iframe>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .visit .split__copy { padding: var(--section-pad) 88px; }
  .visit__eyebrow { margin-bottom: 18px; }
  .visit__heading { margin-bottom: 28px; }
  .visit__facts { display: grid; grid-template-columns: auto 1fr; gap: 10px 28px; font-size: 15.5px; color: var(--body); margin: 0 0 36px; font-weight: 300; }
  .visit__facts dt { letter-spacing: .12em; text-transform: uppercase; font-size: 12px; color: var(--muted); font-weight: 500; padding-top: 3px; }
  .visit__facts dd { margin: 0; }
  .visit__facts dd p { margin: 0; }
  .visit__phone { color: var(--ink); border-bottom: 1px solid var(--gold-2); }
  .visit__phone:hover { color: var(--gold-dark); }
  .visit__map { position: relative; min-height: 560px; background: var(--sand); }
  .visit__map iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; filter: grayscale(20%); }
  @media (max-width: 1023px) {
    .visit .split__copy { padding: var(--section-pad-mobile) var(--gutter-mobile); }
    .visit__map { min-height: 320px; }
    .visit .actions { flex-direction: column; align-items: stretch; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Visit us",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Visit Us" },
    { "type": "text", "id": "heading", "label": "Heading", "info": "Defaults to the street address in Theme settings." },
    { "type": "checkbox", "id": "show_phone", "label": "Show phone", "default": true },
    { "type": "text", "id": "book_label", "label": "Booking button", "default": "Book an Appointment" },
    { "type": "text", "id": "directions_label", "label": "Directions button", "default": "Get Directions" }
  ],
  "blocks": [
    { "type": "fact", "name": "Detail", "settings": [
      { "type": "text", "id": "label", "label": "Label", "default": "Hours" },
      { "type": "richtext", "id": "value", "label": "Value", "default": "<p>Mon–Fri 9:00am – 5:00pm<br>Sat 9:30am – 1:30pm · Sun closed</p>" }
    ] }
  ],
  "max_blocks": 4,
  "presets": [{
    "name": "Visit us",
    "blocks": [
      { "type": "fact", "settings": { "label": "Hours", "value": "<p>Mon–Fri 9:00am – 5:00pm<br>Sat 9:30am – 1:30pm · Sun closed</p>" } },
      { "type": "fact", "settings": { "label": "Parking", "value": "<p>Street parking on Langtree Ave &amp; Deakin Ave</p>" } }
    ]
  }]
}
{% endschema %}
