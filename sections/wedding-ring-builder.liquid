{%- comment -%}
  Burrows Wedding Ring Builder: Mark's designer (BurrowsJewellers/ring-magic-studio), exactly as he built it, on the
  website. Between the shop's header and footer the page is his: "Design Your Wedding Ring", the 3D designer and
  "Your ring" (or, with the View setting on Catalogue, his "The Collection" page). The only additions are ordering
  (Pay deposit adds the deposit to the shop's cart with the design as line item properties and goes to the cart)
  and the dashboard's staff mode (?staff=1).

  Source: wedding-ring-mark/ in this repo. mark/src is his repo's src, copied unchanged; shop/ is the adapter
  (cart, price API, CDN photos and models, staff mode); `npm run build` there writes assets/wedding-ring-builder.js.
  The page is mounted in a shadow root so his styles apply exactly and the theme's CSS can't reach in.
  This section adds no styles of its own: what you see is his.

  Prices: {{ api_base }}/price (the wedding ring API on the droplet, Infinity's configurator). Order pictures:
  {{ api_base }}/preview.
{%- endcomment -%}
{%- assign s = section.settings -%}
{%- assign api_base = s.api_base | strip | default: 'https://dashboard.burrowsjewellers.com.au/wedding-ring/api' -%}
{%- assign deposit_variant = s.deposit_product.selected_or_first_available_variant -%}
{%- assign builder_path = s.builder_path | strip | default: '/pages/wedding-ring-builder' -%}
{%- assign quote_only = s.quote_only -%}
{%- if deposit_variant == blank or deposit_variant.available == false -%}
  {%- assign quote_only = true -%}
{%- endif -%}
{%- assign catalogue_path = s.catalogue_path | strip | default: '/pages/wedding-ring-catalogue' -%}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500&family=Cormorant+Garamond:wght@400;500;600&family=Great+Vibes&family=Jost:wght@300;400;500&display=swap">
<div class="wr-mark full-width" data-wr-app aria-busy="true" style="display:block;min-height:80vh;background:oklch(0.985 0.004 90);">
  <div data-wr-fallback style="padding:96px 24px;text-align:center;font-family:Jost,system-ui,sans-serif;color:#6b6890;">Loading the ring designer…</div>
</div>
<noscript><p style="padding:24px;text-align:center;">The ring designer needs JavaScript. Call us on {{ settings.store_phone_display }} and we will design it with you.</p></noscript>
<script type="application/json" data-wr-config>
  {
    "view": {{ s.view | default: 'designer' | json }},
    "apiBase": {{ api_base | json }},
    "depositVariantId": {% if quote_only %}0{% else %}{{ deposit_variant.id | default: 0 }}{% endif %},
    "depositAud": {{ deposit_variant.price | default: 20000 | divided_by: 100 }},
    "pageUrl": {{ shop.url | append: builder_path | json }},
    "catalogueUrl": {{ shop.url | append: catalogue_path | json }}
  }
</script>
{%- if quote_only and s.view != 'catalogue' -%}
<div data-wr-quote-fallback style="max-width:56rem;margin:1rem auto;padding:1rem;text-align:center;">
  <p>Ask us to confirm the price of your design. No payment is required.</p>
  <a href="mailto:workshop@burrowsjewellers.com.au?subject=Confirm%20Wedding%20Ring%20Pricing">Confirm Pricing</a>
</div>
<script>
(() => {
  const fallback = document.querySelector('[data-wr-quote-fallback]');
  const host = document.querySelector('[data-wr-app]');
  if (!fallback || !host) return;
  const query = new URLSearchParams(window.location.search);
  if (query.get('staff') === '1') {
    fallback.hidden = true;
    return;
  }

  // Keep an email option even if the customer's browser cannot load the 3D view.
  const fallbackLink = fallback.querySelector('a');
  const fallbackMail = new URL(fallbackLink.href);
  const designUrl = new URL(window.location.href);
  for (const key of [...designUrl.searchParams.keys()]) {
    if (!['ring','metal','side','tone','w','t','profile','finish','size','grade','sgrade','stone','ssize'].includes(key)) {
      designUrl.searchParams.delete(key);
    }
  }
  designUrl.hash = '';
  fallbackMail.searchParams.set('body', 'Hello Burrows Jewellers,\n\nPlease confirm the price of this wedding ring:\n' + designUrl.href + '\n\nName:\nPhone:\n');
  fallbackLink.href = fallbackMail.href;

  function attachQuoteMode() {
    const root = host.shadowRoot;
    if (!root) return false;
    // Supplier model metadata audit (25 Nov 2026): these codes have exactly
    // zones 1 and 2 in a single material group, with no stone groups.
    // Other codes and all mixed-metal designs stay confirmation-only.
    const estimatedSkus = new Set(["AC","AD","AG","AH","AS","EA","FB","IN1243","AC-Flat","AD-Flat","AG-Flat","AH-Flat","AS-Flat","EA-Flat","AK","AK-Flat"]);
    const classics = { ab2: 'AB', ac6: 'AC', ad7: 'AD', ag2: 'AG', ah2: 'AH', ak1: 'AK', as2: 'AS', ea: 'EA', fb6: 'FB' };
    const sync = () => {
      const links = [...root.querySelectorAll('a[href^="mailto:workshop@burrowsjewellers.com.au?"]')];
      const enquiry = links.find(link => link.closest('div')?.querySelector(':scope > dl'));
      // If rendering failed, keep the fallback quote link visible.
      fallback.hidden = Boolean(enquiry);
      if (!enquiry) return;
      const summary = enquiry.parentElement;
      const hide = element => { if (!element.hidden) element.hidden = true; };
      const fields = new Map([...summary.querySelectorAll('dt')].map(dt => [dt.textContent.trim(), dt.nextElementSibling?.textContent.trim()]));
      const styleSelect = root.querySelector('select:has(option[value="ac6"])');
      const id = styleSelect?.value || '';
      const fit = fields.get('Fit');
      const profile = fields.get('Profile');
      const classic = classics[id];
      const classicFitKnown = fit === 'Standard' || fit === 'Comfit' || profile === 'Flat' || profile === 'Court' || (id === 'fb6' && !fit && !profile);
      const sku = classic && classicFitKnown
        ? classic + (fit === 'Standard' || profile === 'Flat' ? '-Flat' : '')
        : (/^in\d{4}$/.test(id) ? id.toUpperCase() : '');
      const showEstimate = estimatedSkus.has(sku) && Boolean(fields.get('Metal grade')) && !fields.has('Side grade');
      for (const price of summary.querySelectorAll(':scope > [aria-live="polite"]')) {
        if (price.hidden === showEstimate) price.hidden = !showEstimate;
        const label = price.querySelector('span');
        if (label?.textContent === 'Supplier RRP') label.textContent = 'Estimated retail price';
      }
      for (const button of summary.querySelectorAll(':scope > button')) {
        if (/^Pay .* deposit$|^Preparing checkout/.test(button.textContent.trim())) {
          button.disabled = true;
          hide(button);
        }
      }
      for (const p of summary.querySelectorAll(':scope > p')) {
        if (/^Made to order\.|^Select your ring size to purchase$/.test(p.textContent.trim())) hide(p);
      }
      if (enquiry.textContent.trim() !== 'Confirm Pricing') enquiry.textContent = 'Confirm Pricing';
      const mail = new URL(enquiry.href);
      const subject = mail.searchParams.get('subject') || '';
      if (subject.startsWith('Ring enquiry')) {
        mail.searchParams.set('subject', subject.replace(/^Ring enquiry/, 'Confirm Wedding Ring Pricing'));
        enquiry.href = mail.href;
      }
      if (!summary.querySelector(':scope > [data-wr-quote-message]')) {
        const message = document.createElement('p');
        message.setAttribute('data-wr-quote-message', '');
        message.className = 'mt-4 text-sm text-muted-foreground';
        message.textContent = 'Ask us to confirm the price of your design. No payment is required.';
        enquiry.before(message);
      }
    };
    const style = document.createElement('style');
    style.textContent = '[hidden] { display: none !important; }';
    root.append(style);
    new MutationObserver(sync).observe(root, { subtree: true, childList: true, characterData: true, attributes: true, attributeFilter: ['href'] });
    sync();
    return true;
  }
  if (!attachQuoteMode()) {
    const wait = new MutationObserver(() => { if (attachQuoteMode()) wait.disconnect(); });
    wait.observe(host, { attributes: true, attributeFilter: ['aria-busy'] });
  }
})();
</script>
{%- endif -%}
{%- comment -%} The built bundle is 1.5 MB. While a new build waits for a real git push (the GitHub API can't carry it),
    it is served from Shopify Files through the Script URL setting; clear the setting once assets/wedding-ring-builder.js
    is the new build. {%- endcomment -%}
{%- if s.script_url != blank -%}
<script src="{{ s.script_url }}" type="module"></script>
{%- else -%}
<script src="{{ 'wedding-ring-builder.js' | asset_url }}" type="module"></script>
{%- endif -%}

{% schema %}
{
  "name": "Wedding ring builder",
  "tag": "section",
  "class": "section-wedding-ring-builder",
  "limit": 1,
  "settings": [
    { "type": "select", "id": "view", "label": "View", "default": "designer", "options": [ { "value": "designer", "label": "Designer" }, { "value": "catalogue", "label": "Catalogue (The Collection)" } ] },
    { "type": "header", "content": "Ordering" },
    { "type": "checkbox", "id": "quote_only", "label": "Request quotes only", "default": true, "info": "Disable deposits and display estimates only for checked configurations. Keep the deposit product in Draft to also block purchases through older carts or pages." },
    { "type": "product", "id": "deposit_product", "label": "Deposit product", "info": "The fixed-price deposit product (Made-to-Order Ring Deposit). Its first variant is added to the cart with the design as line item properties." },
    { "type": "text", "id": "api_base", "label": "Wedding ring API base URL", "default": "https://dashboard.burrowsjewellers.com.au/wedding-ring/api" },
    { "type": "header", "content": "Pages" },
    { "type": "text", "id": "builder_path", "label": "Designer page path", "default": "/pages/wedding-ring-builder" },
    { "type": "text", "id": "catalogue_path", "label": "Catalogue page path", "default": "/pages/wedding-ring-catalogue" },
    { "type": "text", "id": "script_url", "label": "Script URL (optional)", "info": "Leave blank to load assets/wedding-ring-builder.js from the theme. Set to a Shopify Files URL to load a new build from Files until it is committed." }
  ],
  "presets": [ { "name": "Wedding ring builder" } ]
}
{% endschema %}
