{%- comment -%}
  Burrows Wedding Ring Builder: Mark's designer (BurrowsJewellers/ring-magic-studio), exactly as he built it, on the
  website. Between the shop's header and footer the page is his: "Design Your Wedding Ring", the 3D designer and
  "Your ring" (or, with the View setting on Catalogue, his "The Collection" page). The only additions are ordering
  (Pay deposit adds the deposit to the shop's cart with the design as line item properties and goes to the cart)
  and the dashboard's staff mode (?staff=1).

  Source: wedding-ring-mark/ in this repo. mark/src is his repo's src, copied unchanged; shop/ is the adapter
  (cart, price API, CDN photos and models, staff mode); `npm run build` there writes assets/wedding-ring-builder.js.
  The page is mounted in a shadow root so his styles apply exactly and the theme's CSS can't reach in.
  This section adds no styles of its own: what you see is his.

  Prices: {{ api_base }}/price (the wedding ring API on the droplet, Infinity's configurator). Order pictures:
  {{ api_base }}/preview.
{%- endcomment -%}
{%- assign s = section.settings -%}
{%- assign api_base = s.api_base | strip | default: 'https://dashboard.burrowsjewellers.com.au/wedding-ring/api' -%}
{%- assign deposit_variant = s.deposit_product.selected_or_first_available_variant -%}
{%- assign builder_path = s.builder_path | strip | default: '/pages/wedding-ring-builder' -%}
{%- assign catalogue_path = s.catalogue_path | strip | default: '/pages/wedding-ring-catalogue' -%}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500&family=Cormorant+Garamond:wght@400;500;600&family=Great+Vibes&family=Jost:wght@300;400;500&display=swap">
<div class="wr-mark" data-wr-app aria-busy="true" style="display:block;min-height:80vh;background:oklch(0.985 0.004 90);">
  <div data-wr-fallback style="padding:96px 24px;text-align:center;font-family:Jost,system-ui,sans-serif;color:#6b6890;">Loading the ring designer…</div>
</div>
<noscript><p style="padding:24px;text-align:center;">The ring designer needs JavaScript. Call us on {{ settings.store_phone_display }} and we will design it with you.</p></noscript>
<script type="application/json" data-wr-config>
  {
    "view": {{ s.view | default: 'designer' | json }},
    "apiBase": {{ api_base | json }},
    "depositVariantId": {{ deposit_variant.id | default: 0 }},
    "depositAud": {{ deposit_variant.price | default: 20000 | divided_by: 100 }},
    "pageUrl": {{ shop.url | append: builder_path | json }},
    "catalogueUrl": {{ shop.url | append: catalogue_path | json }}
  }
</script>
{%- comment -%} The built bundle is 1.5 MB. While a new build waits for a real git push (the GitHub API can't carry it),
    it is served from Shopify Files through the Script URL setting; clear the setting once assets/wedding-ring-builder.js
    is the new build. {%- endcomment -%}
{%- if s.script_url != blank -%}
<script src="{{ s.script_url }}" type="module"></script>
{%- else -%}
<script src="{{ 'wedding-ring-builder.js' | asset_url }}" type="module"></script>
{%- endif -%}

{% schema %}
{
  "name": "Wedding ring builder",
  "tag": "section",
  "class": "section-wedding-ring-builder",
  "limit": 1,
  "settings": [
    { "type": "select", "id": "view", "label": "View", "default": "designer", "options": [ { "value": "designer", "label": "Designer" }, { "value": "catalogue", "label": "Catalogue (The Collection)" } ] },
    { "type": "header", "content": "Ordering" },
    { "type": "product", "id": "deposit_product", "label": "Deposit product", "info": "The fixed-price deposit product (Made-to-Order Ring Deposit). Its first variant is added to the cart with the design as line item properties." },
    { "type": "text", "id": "api_base", "label": "Wedding ring API base URL", "default": "https://dashboard.burrowsjewellers.com.au/wedding-ring/api" },
    { "type": "header", "content": "Pages" },
    { "type": "text", "id": "builder_path", "label": "Designer page path", "default": "/pages/wedding-ring-builder" },
    { "type": "text", "id": "catalogue_path", "label": "Catalogue page path", "default": "/pages/wedding-ring-catalogue" },
    { "type": "text", "id": "script_url", "label": "Script URL (optional)", "info": "Leave blank to load assets/wedding-ring-builder.js from the theme. Set to a Shopify Files URL to load a new build from Files until it is committed." }
  ],
  "presets": [ { "name": "Wedding ring builder" } ]
}
{% endschema %}
