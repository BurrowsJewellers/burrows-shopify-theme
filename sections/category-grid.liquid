{%- assign s = section.settings -%}
<section class="full-width section bg-cream cats">
  <div class="container">
    {%- if s.heading != blank or s.eyebrow != blank -%}
      <div class="section-head">
        {%- if s.eyebrow != blank -%}<span class="eyebrow">{{ s.eyebrow }}</span>{%- endif -%}
        {%- if s.heading != blank -%}<h2 class="h2">{{ s.heading }}</h2>{%- endif -%}
      </div>
    {%- endif -%}
    <div class="cats__grid">
      {%- for block in section.blocks -%}
        {%- liquid
          assign col = block.settings.collection
          assign href = block.settings.url
          if href == blank and col != blank
            assign href = col.url
          endif
          assign label = block.settings.label
          if label == blank and col != blank
            assign label = col.title
          endif
          assign img = block.settings.image
          if img == blank and col != blank
            assign img = col.featured_image
          endif
        -%}
        <a class="cats__tile{% if block.settings.wide %} cats__tile--wide{% endif %}" href="{{ href | default: '#' }}" {{ block.shopify_attributes }}>
          <div class="cats__media">
            {%- if block.settings.wide -%}
              {% render 'bg-image', image: img, fallback: block.settings.image_url, alt: label, parallax: 0.12, width: 1920 %}
            {%- else -%}
              {% render 'bg-image', image: img, fallback: block.settings.image_url, alt: label, width: 900 %}
            {%- endif -%}
          </div>
          <div class="cats__cap">
            <span class="cats__name">{{ label }}</span>
            <span class="cats__cta">{{ block.settings.cta | default: 'Shop' }} &rarr;</span>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .cats__grid { display: grid; grid-template-columns: repeat(4, 1fr); grid-auto-rows: 340px; gap: 20px; }
  .cats__tile { position: relative; display: block; overflow: hidden; background: var(--navy-3); transition: transform .4s; }
  .cats__tile:hover { transform: scale(1.015); }
  .cats__tile--wide { grid-column: 1 / -1; height: 260px; }
  .cats__tile--wide:hover { transform: scale(1.008); }
  .cats__media { position: absolute; inset: 0; }
  .cats__media .cover { position: absolute; inset: 0; }
  .cats__media img, .cats__media svg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .cats__cap { position: absolute; left: 0; right: 0; bottom: 0; padding: 60px 24px 20px; background: linear-gradient(transparent, rgba(var(--navy-rgb), .72)); pointer-events: none; display: flex; align-items: baseline; justify-content: space-between; gap: 12px; }
  .cats__name { font-family: var(--font-heading); font-size: 26px; color: var(--cream); }
  .cats__tile--wide .cats__name { font-size: 30px; }
  .cats__cta { font-size: 12px; letter-spacing: .12em; text-transform: uppercase; color: var(--gold-2); white-space: nowrap; }
  @media (max-width: 1023px) {
    .cats__grid { grid-template-columns: 1fr 1fr; grid-auto-rows: 220px; gap: 12px; }
    .cats__tile--wide { height: 200px; }
    .cats__cap { padding: 40px 16px 14px; }
    .cats__name { font-size: 22px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Category grid",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Shop the Collection" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Find something they'll keep forever" }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "label", "label": "Label (defaults to collection title)" },
        { "type": "url", "id": "url", "label": "Link (defaults to the collection)" },
        { "type": "image_picker", "id": "image", "label": "Image (defaults to collection image)" },
        { "type": "text", "id": "image_url", "label": "Image URL fallback" },
        { "type": "text", "id": "cta", "label": "Call to action", "default": "Shop" },
        { "type": "checkbox", "id": "wide", "label": "Full-width banner tile", "default": false }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [{
    "name": "Category grid",
    "blocks": [
      { "type": "tile", "settings": { "label": "Rings", "url": "shopify://collections/rings" } },
      { "type": "tile", "settings": { "label": "Necklaces", "url": "shopify://collections/necklace" } },
      { "type": "tile", "settings": { "label": "Earrings", "url": "shopify://collections/earrings" } },
      { "type": "tile", "settings": { "label": "Bracelets", "url": "shopify://collections/bracelets" } },
      { "type": "tile", "settings": { "label": "Watches — Citizen, Casio & more", "url": "shopify://collections/watches", "cta": "Shop watches", "wide": true } }
    ]
  }]
}
{% endschema %}
