{%- assign s = section.settings -%}
<section class="full-width split iwt bg-{{ s.background }}{% if s.image_position == 'right' %} split--reverse{% endif %}" id="{{ s.anchor }}">
  {%- if s.image_position == 'left' -%}
    <div class="split__media" style="min-height: {{ s.min_height }}px">
      {% render 'bg-image', image: s.image, fallback: s.image_url, alt: s.image_alt, parallax: 0.14, width: 1400 %}
    </div>
  {%- endif -%}
  <div class="split__copy">
    {%- if s.badge != blank -%}
      <div class="iwt__badge"><span></span>{{ s.badge }}</div>
    {%- endif -%}
    {%- if s.eyebrow != blank -%}<div class="eyebrow iwt__eyebrow">{{ s.eyebrow }}</div>{%- endif -%}
    {%- if s.heading != blank -%}<h2 class="h2 iwt__heading">{{ s.heading }}</h2>{%- endif -%}
    {%- if s.text != blank -%}<div class="lede rte iwt__text">{{ s.text }}</div>{%- endif -%}

    {%- assign steps = section.blocks | where: 'type', 'step' -%}
    {%- if steps.size > 0 -%}
      <div class="iwt__steps">
        {%- for block in steps -%}
          <div class="iwt__step" {{ block.shopify_attributes }}>
            <span class="iwt__num">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
            <div><strong>{{ block.settings.title }}</strong>{% if block.settings.text != blank %} &mdash; {{ block.settings.text }}{% endif %}</div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- assign buttons = section.blocks | where: 'type', 'button' -%}
    {%- if buttons.size > 0 -%}
      <div class="actions">
        {%- for block in buttons -%}
          {%- liquid
            assign href = block.settings.url
            if href == blank and block.settings.use_booking_url
              assign href = settings.booking_url
            endif
          -%}
          {%- if block.settings.style == 'link' -%}
            <a class="link-gold" href="{{ href | default: '#' }}" {{ block.shopify_attributes }}>{{ block.settings.label }}</a>
          {%- else -%}
            <a class="btn btn--{{ block.settings.style }}" href="{{ href | default: '#' }}" {{ block.shopify_attributes }}>{{ block.settings.label }}</a>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
  {%- if s.image_position == 'right' -%}
    <div class="split__media" style="min-height: {{ s.min_height }}px">
      {% render 'bg-image', image: s.image, fallback: s.image_url, alt: s.image_alt, parallax: 0.14, width: 1400 %}
    </div>
  {%- endif -%}
</section>

{% stylesheet %}
  .iwt .cover { position: absolute; inset: 0; }
  .iwt .cover img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .iwt__badge { display: inline-flex; align-items: center; gap: 8px; border: 1px solid var(--gold-dark); color: #8a7020; font-size: 11px; letter-spacing: .22em; text-transform: uppercase; padding: 7px 14px; margin-bottom: 22px; font-weight: 500; align-self: flex-start; }
  .iwt__badge span { width: 6px; height: 6px; background: var(--gold-dark); border-radius: 50%; display: inline-block; }
  .iwt__eyebrow { margin-bottom: 18px; }
  .iwt__heading { margin-bottom: 24px; }
  .iwt__text { margin-bottom: 36px; }
  .iwt__steps { display: flex; flex-direction: column; gap: 18px; margin: -8px 0 36px; }
  .iwt__step { display: flex; gap: 16px; align-items: baseline; font-size: 15px; color: #33365a; font-weight: 300; }
  .iwt__step strong { font-weight: 500; color: var(--ink); }
  .iwt__num { font-family: var(--font-heading); font-size: 19px; color: var(--gold-dark); min-width: 26px; }
  @media (max-width: 1023px) {
    .iwt .split__media { min-height: 320px !important; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Image with text",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "image_url", "label": "Image URL fallback", "info": "Placeholder until you choose an image above." },
    { "type": "text", "id": "image_alt", "label": "Image description (alt)" },
    { "type": "select", "id": "image_position", "label": "Image position", "options": [ { "value": "left", "label": "Left" }, { "value": "right", "label": "Right" } ], "default": "left" },
    { "type": "range", "id": "min_height", "label": "Minimum height", "min": 400, "max": 800, "step": 20, "unit": "px", "default": 620 },
    { "type": "select", "id": "background", "label": "Background", "options": [ { "value": "cream", "label": "Cream" }, { "value": "sand", "label": "Sand" } ], "default": "cream" },
    { "type": "text", "id": "badge", "label": "Pill badge (optional)" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "text", "id": "anchor", "label": "Anchor id (for #links)", "default": "" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Numbered step",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Choose your metal" },
        { "type": "text", "id": "text", "label": "Text", "default": "yellow, white or rose gold, or platinum" }
      ]
    },
    {
      "type": "button",
      "name": "Button",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Learn more" },
        { "type": "url", "id": "url", "label": "Link" },
        { "type": "checkbox", "id": "use_booking_url", "label": "Use the booking URL from Theme settings", "default": false },
        { "type": "select", "id": "style", "label": "Style", "options": [
          { "value": "ink", "label": "Solid navy" },
          { "value": "gold", "label": "Solid gold" },
          { "value": "outline-dark", "label": "Outline" },
          { "value": "link", "label": "Gold text link" }
        ], "default": "ink" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Image with text",
      "settings": { "eyebrow": "The Workshop", "heading": "Looked after here, never sent away" },
      "blocks": [ { "type": "button" } ]
    }
  ]
}
{% endschema %}
