{%- assign s = section.settings -%}
<section class="full-width cf bg-{{ s.background }}" id="contact">
  <div class="cf__inner">
    <div class="cf__info">
      {%- if s.eyebrow != blank -%}<div class="eyebrow cf__eyebrow">{{ s.eyebrow }}</div>{%- endif -%}
      <h2 class="h2 cf__heading">{{ s.heading }}</h2>
      {%- if s.text != blank -%}<div class="rte lede cf__text">{{ s.text }}</div>{%- endif -%}
      <dl class="cf__facts">
        {%- if settings.store_phone_display != blank -%}<dt>Phone</dt><dd><a href="tel:{{ settings.store_phone_tel }}">{{ settings.store_phone_display }}</a></dd>{%- endif -%}
        {%- if shop.email != blank and s.show_email -%}<dt>Email</dt><dd><a href="mailto:{{ shop.email }}">{{ shop.email }}</a></dd>{%- endif -%}
        {%- if settings.store_address_line != blank -%}<dt>Visit</dt><dd>{{ settings.store_address_line }}</dd>{%- endif -%}
        {%- if s.hours != blank -%}<dt>Hours</dt><dd>{{ s.hours }}</dd>{%- endif -%}
      </dl>
      {%- if settings.booking_url != blank and s.booking_label != blank -%}
        <a class="btn btn--outline-dark" href="{{ settings.booking_url }}" target="_blank" rel="noopener">{{ s.booking_label }}</a>
      {%- endif -%}
    </div>
    <div class="cf__formwrap">
      {%- form 'contact', class: 'cf__form' -%}
        {%- if form.posted_successfully? -%}
          <div class="form-success">{{ s.success }}</div>
        {%- endif -%}
        {%- if form.errors -%}
          <div class="form-errors">Please check the form:<ul>{%- for field in form.errors -%}<li>{{ form.errors.translated_fields[field] | capitalize }} {{ form.errors.messages[field] }}</li>{%- endfor -%}</ul></div>
        {%- endif -%}
        <div class="field"><label for="ContactName">Name</label><input class="input" id="ContactName" type="text" name="contact[name]" value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}" required autocomplete="name"></div>
        <div class="field"><label for="ContactEmail">Email</label><input class="input" id="ContactEmail" type="email" name="contact[email]" value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}" required autocomplete="email"></div>
        <div class="field"><label for="ContactPhone">Phone</label><input class="input" id="ContactPhone" type="tel" name="contact[phone]" value="{{ form.phone }}" autocomplete="tel"></div>
        {%- if s.show_product_fields -%}
          <div class="cf__row">
            <div class="field"><label for="ContactSku">SKU <span class="cf__opt">(optional)</span></label><input class="input" id="ContactSku" type="text" name="contact[SKU]" autocomplete="off"></div>
            <div class="field"><label for="ContactDesign">Design number <span class="cf__opt">(optional)</span></label><input class="input" id="ContactDesign" type="text" name="contact[Design number]" autocomplete="off"></div>
          </div>
        {%- endif -%}
        <div class="field"><label for="ContactBody">Message</label><textarea class="input" id="ContactBody" name="contact[body]" required>{{ form.body }}</textarea></div>
        <button class="btn btn--gold btn--lg" type="submit">{{ s.button }}</button>
      {%- endform -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .cf { padding: var(--section-pad) var(--gutter); }
  .cf__inner { max-width: var(--page-max); margin: 0 auto; display: grid; grid-template-columns: 1fr 1.1fr; gap: 72px; align-items: start; }
  .cf__eyebrow { margin-bottom: 16px; display: block; }
  .cf__heading { margin-bottom: 20px; }
  .cf__text { margin-bottom: 28px; }
  .cf__facts { display: grid; grid-template-columns: auto 1fr; gap: 10px 28px; font-size: 15.5px; color: var(--body); margin: 0 0 32px; font-weight: 300; }
  .cf__facts dt { letter-spacing: .12em; text-transform: uppercase; font-size: 12px; color: var(--muted); font-weight: 500; padding-top: 3px; }
  .cf__facts dd { margin: 0; }
  .cf__facts a { color: var(--ink); border-bottom: 1px solid var(--gold-2); }
  .cf__form { display: flex; flex-direction: column; }
  .cf__row { display: grid; grid-template-columns: 1fr 1fr; gap: 0 16px; }
  .cf__opt { font-weight: 300; letter-spacing: 0; text-transform: none; color: var(--muted); }
  @media (max-width: 520px) { .cf__row { grid-template-columns: 1fr; } }
  @media (max-width: 900px) { .cf__inner { grid-template-columns: 1fr; gap: 40px; } }
{% endstylesheet %}

{% schema %}
{
  "name": "Contact form",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Get in touch" },
    { "type": "checkbox", "id": "show_product_fields", "label": "Show SKU and design number fields", "info": "Optional fields. The sizing links on ring pages fill them in automatically.", "default": true },
    { "type": "text", "id": "heading", "label": "Heading", "default": "We'd love to hear from you" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Questions about a piece, a repair or a custom design — call, email or drop in. To book an appointment, use the booking link.</p>" },
    { "type": "checkbox", "id": "show_email", "label": "Show store email", "default": true },
    { "type": "text", "id": "hours", "label": "Hours", "default": "Mon–Fri 9–5 · Sat 9:30–1:30" },
    { "type": "text", "id": "booking_label", "label": "Booking button label", "default": "Book an appointment" },
    { "type": "text", "id": "button", "label": "Submit button", "default": "Send message" },
    { "type": "text", "id": "success", "label": "Success message", "default": "Thanks — we'll be in touch within one business day." },
    { "type": "select", "id": "background", "label": "Background", "options": [ { "value": "cream", "label": "Cream" }, { "value": "sand", "label": "Sand" } ], "default": "cream" }
  ],
  "presets": [{ "name": "Contact form" }]
}
{% endschema %}
