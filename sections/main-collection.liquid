{%- liquid
  assign s = section.settings
  assign per_page = s.products_per_page | default: 24
  assign sort_by = collection.sort_by | default: collection.default_sort_by
  assign sort_options = 'manual|Featured,best-selling|Best selling,title-ascending|Alphabetical A-Z,price-ascending|Price low to high,price-descending|Price high to low,created-descending|Newest' | split: ','
  assign current_sort_label = 'Featured'
  for opt in sort_options
    assign kv = opt | split: '|'
    if kv[0] == sort_by
      assign current_sort_label = kv[1]
    endif
  endfor
  assign has_active = false
  for filter in collection.filters
    if filter.active_values.size > 0 or filter.min_value.value != blank or filter.max_value.value != blank
      assign has_active = true
    endif
  endfor
-%}

<section class="full-width col">
  <div class="page-hero">
    {%- if s.show_breadcrumbs -%}
      <nav class="crumbs crumbs--center" aria-label="Breadcrumb">
        <a href="{{ routes.root_url }}">Home</a><span>&rsaquo;</span>
        {%- if s.parent_label != blank and s.parent_url != blank -%}<a href="{{ s.parent_url }}">{{ s.parent_label }}</a><span>&rsaquo;</span>{%- endif -%}
        <span class="cur">{{ collection.title }}</span>
      </nav>
    {%- endif -%}
    <h1>{{ collection.title }}</h1>
    <div class="page-hero__diamond"></div>
    {%- if s.show_description and collection.description != blank -%}
      <p>{{ collection.description | strip_html | truncatewords: s.description_words }}</p>
    {%- endif -%}
  </div>

  {%- if s.show_type_nav -%}
    {%- for f in collection.filters -%}
      {%- assign flabel = f.label | downcase -%}
      {%- if flabel contains 'product type' and f.values.size > 1 -%}
        {%- assign any_type_active = false -%}
        {%- for v in f.values -%}{%- if v.active -%}{%- assign any_type_active = true -%}{%- endif -%}{%- endfor -%}
        <nav class="col__types" aria-label="Shop by type">
          {%- if s.type_nav_label != blank -%}<span class="col__types-label">{{ s.type_nav_label }}</span>{%- endif -%}
          <a class="col__type{% unless any_type_active %} on{% endunless %}" href="{{ collection.url }}">All <small>{{ collection.all_products_count }}</small></a>
          {%- for v in f.values -%}
            {%- if v.count > 0 -%}
              {%- assign last_char = v.label | slice: -1 -%}
              {%- liquid
                assign tlabel = v.label
                if v.label == 'Watch'
                  assign tlabel = 'Watches'
                elsif v.label == 'Giftware' or v.label contains 'Jewellery' or v.label contains ' ' or last_char == 's'
                  assign tlabel = v.label
                else
                  assign tlabel = v.label | append: 's'
                endif
              -%}
              <a class="col__type{% if v.active %} on{% endif %}" href="{{ collection.url }}?{{ v.param_name }}={{ v.value | url_encode }}">{{ tlabel }} <small>{{ v.count }}</small></a>
            {%- endif -%}
          {%- endfor -%}
        </nav>
      {%- endif -%}
    {%- endfor -%}
  {%- endif -%}

  <div class="col__bar">
    <div class="col__filters">
      {%- for filter in collection.filters -%}
        {%- case filter.type -%}
          {%- when 'list', 'boolean' -%}
            <details class="col__pill">
              <summary>{{ filter.label }}{% if filter.active_values.size > 0 %} &middot; {{ filter.active_values.size }}{% endif %}{% render 'icon', name: 'chevron', size: 9 %}</summary>
              <div class="col__pop">
                {%- for value in filter.values -%}
                  <a href="{% if value.active %}{{ value.url_to_remove }}{% else %}{{ value.url_to_add }}{% endif %}" class="{% if value.active %}on{% endif %}{% if value.count == 0 %} zero{% endif %}">
                    <span class="col__box">{% if value.active %}<svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="#0f1233" stroke-width="3.4" aria-hidden="true"><path d="m4 12 5 5 11-11"/></svg>{% endif %}</span>{{ value.label }} <span class="col__count">({{ value.count }})</span>
                  </a>
                {%- endfor -%}
              </div>
            </details>
          {%- when 'price_range' -%}
            <details class="col__pill">
              <summary>Price{% if filter.min_value.value != blank or filter.max_value.value != blank %} &middot; set{% endif %}{% render 'icon', name: 'chevron', size: 9 %}</summary>
              <div class="col__pop col__pop--price">
                <form method="get" action="{{ collection.url }}">
                  {%- if sort_by != blank -%}<input type="hidden" name="sort_by" value="{{ sort_by }}">{%- endif -%}
                  {%- for f in collection.filters -%}
                    {%- for v in f.active_values -%}<input type="hidden" name="{{ v.param_name }}" value="{{ v.value }}">{%- endfor -%}
                  {%- endfor -%}
                  <div class="col__pricerow">
                    <label><span>From</span><input class="input" type="number" name="{{ filter.min_value.param_name }}" min="0" max="{{ filter.range_max | money_without_currency | replace: ',', '' }}" placeholder="0" value="{% if filter.min_value.value %}{{ filter.min_value.value | money_without_currency | replace: ',', '' }}{% endif %}"></label>
                    <label><span>To</span><input class="input" type="number" name="{{ filter.max_value.param_name }}" min="0" max="{{ filter.range_max | money_without_currency | replace: ',', '' }}" placeholder="{{ filter.range_max | money_without_currency | replace: ',', '' }}" value="{% if filter.max_value.value %}{{ filter.max_value.value | money_without_currency | replace: ',', '' }}{% endif %}"></label>
                  </div>
                  <button class="btn btn--ink" type="submit">Apply</button>
                </form>
              </div>
            </details>
        {%- endcase -%}
      {%- endfor -%}
    </div>
    <div class="col__right">
      <span class="col__num">{{ collection.products_count }} {% if collection.products_count == 1 %}piece{% else %}pieces{% endif %}</span>
      <details class="col__pill col__sort">
        <summary>Sort &middot; {{ current_sort_label }}{% render 'icon', name: 'chevron', size: 9 %}</summary>
        <div class="col__pop col__pop--right">
          {%- for opt in sort_options -%}
            {%- assign kv = opt | split: '|' -%}
            <a href="{{ collection.url }}?sort_by={{ kv[0] }}" class="{% if kv[0] == sort_by %}on{% endif %}">{{ kv[1] }}</a>
          {%- endfor -%}
        </div>
      </details>
    </div>
  </div>

  {%- if has_active -%}
    <div class="col__chips">
      {%- for filter in collection.filters -%}
        {%- for value in filter.active_values -%}
          <span class="col__chip">{{ value.label }}<a class="x" href="{{ value.url_to_remove }}" aria-label="Remove {{ value.label | escape }}">&times;</a></span>
        {%- endfor -%}
        {%- if filter.type == 'price_range' -%}
          {%- if filter.min_value.value != blank or filter.max_value.value != blank -%}
            <span class="col__chip">{{ filter.min_value.value | default: 0 | money }} &ndash; {{ filter.max_value.value | default: filter.range_max | money }}<a class="x" href="{{ filter.url_to_remove }}" aria-label="Remove price filter">&times;</a></span>
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}
      <a class="col__clear" href="{{ collection.url }}">Clear all</a>
    </div>
  {%- endif -%}

  <div class="col__grid-wrap">
    {%- paginate collection.products by per_page -%}
      <div class="product-grid">
        {%- for product in collection.products -%}
          {%- render 'product-card', product: product, show_vendor: s.show_vendor -%}
          {%- if s.show_editorial and forloop.index == s.editorial_position -%}
            <a class="col__editorial" href="{{ s.editorial_url | default: '#' }}">
              <span class="d"></span>
              <span class="t">{{ s.editorial_heading }}</span>
              <span class="s">{{ s.editorial_text }}</span>
              <span class="l">{{ s.editorial_link }}</span>
            </a>
          {%- endif -%}
        {%- else -%}
          <div class="col__empty">No products found.{% if has_active %} <a href="{{ collection.url }}">Clear filters</a>{% endif %}</div>
        {%- endfor -%}
      </div>
      {%- render 'pagination', paginate: paginate -%}
    {%- endpaginate -%}
  </div>

  {%- if s.show_trust -%}
    <div class="col__trust">
      <div><span></span>Locally owned in Mildura since 1975</div>
      <div><span></span>Custom design & remodelling</div>
      <div><span></span>Free shipping Australia-wide</div>
      <div><span></span>Afterpay available</div>
    </div>
  {%- endif -%}
</section>

{% stylesheet %}
  .col { background: var(--cream); }
  .col__types { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; padding: 0 var(--gutter) 28px; }
  .col__types-label { flex-basis: 100%; text-align: center; font-size: 11px; letter-spacing: .28em; text-transform: uppercase; color: var(--gold-dark); font-weight: 500; margin-bottom: 4px; }
  .col__type { display: inline-flex; align-items: baseline; gap: 6px; border: 1px solid rgba(var(--gold-dark-rgb), .35); color: var(--ink); font-size: 13px; padding: 9px 16px; transition: .2s; }
  .col__type small { font-size: 11px; color: var(--muted); }
  .col__type:hover { border-color: var(--gold); }
  .col__type.on { background: var(--ink); border-color: var(--ink); color: var(--cream); }
  .col__type.on small { color: var(--gold-2); }
  .col__bar { display: flex; align-items: center; justify-content: space-between; gap: 24px; padding: 14px var(--gutter); border-top: 1px solid rgba(var(--gold-dark-rgb), .14); border-bottom: 1px solid rgba(var(--gold-dark-rgb), .14); flex-wrap: wrap; }
  .col__filters { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
  .col__pill { position: relative; }
  .col__pill > summary { list-style: none; display: flex; align-items: center; gap: 8px; border: 1px solid rgba(var(--gold-dark-rgb), .3); color: var(--body); font-size: 12.5px; letter-spacing: .06em; padding: 10px 16px; cursor: pointer; user-select: none; white-space: nowrap; }
  .col__pill > summary::-webkit-details-marker { display: none; }
  .col__pill > summary:hover { border-color: var(--gold); color: var(--ink); }
  .col__pill[open] > summary { background: var(--ink); color: var(--cream); border-color: var(--ink); }
  .col__pill > summary svg { color: var(--gold-dark); }
  .col__pill[open] > summary svg { color: var(--gold-2); }
  .col__pop { position: absolute; top: calc(100% + 6px); left: 0; z-index: 30; background: var(--cream); border: 1px solid rgba(var(--gold-dark-rgb), .25); border-bottom: 2px solid var(--gold); box-shadow: 0 10px 30px rgba(var(--navy-rgb), .12); padding: 18px 20px; display: flex; flex-direction: column; gap: 12px; min-width: 230px; max-height: 340px; overflow: auto; }
  .col__pop--right { right: 0; left: auto; min-width: 200px; }
  .col__pop a { display: flex; align-items: center; gap: 10px; font-size: 13.5px; color: var(--body); font-weight: 300; }
  .col__pop a:hover { color: var(--ink); }
  .col__pop a.on { color: var(--ink); font-weight: 400; }
  .col__pop a.zero { opacity: .45; }
  .col__box { width: 13px; height: 13px; border: 1px solid rgba(var(--gold-dark-rgb), .45); flex: none; display: inline-flex; align-items: center; justify-content: center; }
  .col__pop a.on .col__box { background: var(--gold); border-color: var(--gold); }
  .col__count { color: var(--muted); font-size: 11.5px; }
  .col__pop--price { min-width: 280px; }
  .col__pricerow { display: flex; gap: 10px; }
  .col__pricerow label { display: flex; flex-direction: column; gap: 4px; font-size: 11px; letter-spacing: .16em; text-transform: uppercase; color: var(--gold-dark); flex: 1; }
  .col__pricerow .input { padding: 10px 12px; font-size: 14px; }
  .col__sort > summary { border-color: transparent; padding-right: 0; }
  .col__sort[open] > summary { background: none; color: var(--ink); border-color: transparent; }
  .col__right { display: flex; align-items: center; gap: 16px; }
  .col__num { font-size: 13px; color: var(--muted); font-weight: 300; white-space: nowrap; }
  .col__chips { display: flex; align-items: center; gap: 10px; padding: 14px var(--gutter) 0; flex-wrap: wrap; }
  .col__chip { display: flex; align-items: center; gap: 9px; background: var(--sand); color: var(--ink); font-size: 12px; padding: 7px 12px; }
  .col__chip .x { color: var(--gold-dark); font-size: 13px; line-height: 1; }
  .col__clear { color: var(--gold-dark); font-size: 11.5px; letter-spacing: .1em; text-transform: uppercase; font-weight: 500; border-bottom: 1px solid var(--gold-2); padding-bottom: 2px; }
  .col__clear:hover { color: var(--ink); }
  .col__grid-wrap { padding: 32px var(--gutter) 60px; }
  .col__editorial { display: flex; flex-direction: column; justify-content: center; align-items: center; text-align: center; gap: 12px; border: 1px solid rgba(var(--gold-dark-rgb), .3); padding: 28px; }
  .col__editorial .d { width: 6px; height: 6px; background: var(--gold); transform: rotate(45deg); }
  .col__editorial .t { font-family: var(--font-heading); font-size: 24px; font-weight: 500; color: var(--ink); line-height: 1.25; }
  .col__editorial .s { font-size: 13px; color: var(--body); font-weight: 300; line-height: 1.6; }
  .col__editorial .l { color: var(--gold-dark); font-size: 12px; letter-spacing: .12em; text-transform: uppercase; font-weight: 500; border-bottom: 1px solid var(--gold-2); padding-bottom: 3px; margin-top: 4px; }
  .col__empty { text-align: center; color: var(--muted); padding: 40px; font-weight: 300; grid-column: 1 / -1; }
  .col__empty a { color: var(--gold-dark); border-bottom: 1px solid var(--gold-2); }
  .col__trust { background: var(--navy-2); border-top: 1px solid rgba(var(--gold-rgb), .25); display: flex; justify-content: center; gap: 56px; padding: 20px 40px; flex-wrap: wrap; }
  .col__trust div { display: flex; align-items: center; gap: 10px; color: rgba(var(--cream-rgb), .75); font-size: 12.5px; letter-spacing: .08em; text-transform: uppercase; font-weight: 400; }
  .col__trust span { width: 5px; height: 5px; background: var(--gold); transform: rotate(45deg); }
  @media (max-width: 820px) {
    .page-hero { padding-top: 40px; }
    .col__bar { padding: 12px var(--gutter-mobile); gap: 12px; }
    .col__filters { gap: 8px; }
    .col__pill > summary { padding: 9px 12px; font-size: 12px; }
    .col__pop { position: fixed; left: 12px; right: 12px; top: auto; bottom: 12px; max-height: 60vh; }
    .col__trust { gap: 14px 24px; padding: 16px var(--gutter-mobile); }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Collection page",
  "settings": [
    { "type": "range", "id": "products_per_page", "label": "Products per page", "min": 12, "max": 48, "step": 4, "default": 24 },
    { "type": "checkbox", "id": "show_vendor", "label": "Show brand on product cards", "default": true },
    { "type": "checkbox", "id": "show_breadcrumbs", "label": "Show breadcrumbs", "default": true },
    { "type": "text", "id": "parent_label", "label": "Breadcrumb parent label", "default": "Jewellery" },
    { "type": "url", "id": "parent_url", "label": "Breadcrumb parent link" },
    { "type": "checkbox", "id": "show_description", "label": "Show collection description", "default": true },
    { "type": "range", "id": "description_words", "label": "Description length (words)", "min": 20, "max": 120, "step": 10, "default": 40 },
    { "type": "header", "content": "Shop by type" },
    { "type": "checkbox", "id": "show_type_nav", "label": "Show product-type pills under the heading", "default": false, "info": "Built from the collection's Product type filter, with counts. Good for Sale." },
    { "type": "text", "id": "type_nav_label", "label": "Pills label", "default": "Shop by type" },
    { "type": "header", "content": "Editorial tile" },
    { "type": "checkbox", "id": "show_editorial", "label": "Show editorial tile in the grid", "default": true },
    { "type": "range", "id": "editorial_position", "label": "Position (after product #)", "min": 2, "max": 12, "step": 1, "default": 5 },
    { "type": "text", "id": "editorial_heading", "label": "Heading", "default": "Can't find it? We'll build it with you." },
    { "type": "text", "id": "editorial_text", "label": "Text", "default": "Custom design and remodelling, guided step by step." },
    { "type": "text", "id": "editorial_link", "label": "Link label", "default": "Book a custom design" },
    { "type": "url", "id": "editorial_url", "label": "Link" },
    { "type": "header", "content": "Footer strip" },
    { "type": "checkbox", "id": "show_trust", "label": "Show trust strip", "default": true }
  ]
}
{% endschema %}
