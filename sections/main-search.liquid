{%- assign s = section.settings -%}
<section class="full-width srch">
  <div class="page-hero">
    <h1>{% if search.performed and search.terms != blank %}Results for &ldquo;{{ search.terms | escape }}&rdquo;{% else %}{{ s.heading }}{% endif %}</h1>
    <div class="page-hero__diamond"></div>
    <form action="{{ routes.search_url }}" method="get" role="search" class="srch__form">
      <label class="visually-hidden" for="SearchInput">Search</label>
      <input class="input" id="SearchInput" type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ s.placeholder }}" autocomplete="off">
      <input type="hidden" name="options[prefix]" value="last">
      <button class="btn btn--gold" type="submit">Search</button>
    </form>
    {%- if search.performed -%}
      <p>{{ search.results_count }} {% if search.results_count == 1 %}result{% else %}results{% endif %}</p>
    {%- endif -%}
  </div>

  {%- if search.performed -%}
    <div class="srch__results">
      {%- paginate search.results by 24 -%}
        {%- assign products = search.results | where: 'object_type', 'product' -%}
        {%- assign others = search.results | reject: 'object_type', 'product' -%}
        {%- if search.results_count == 0 -%}
          <div class="srch__empty">Nothing found for &ldquo;{{ search.terms | escape }}&rdquo;. Try a brand, a style or a stone &mdash; or <a href="{{ routes.all_products_collection_url }}">browse all jewellery</a>.</div>
        {%- endif -%}
        {%- if products.size > 0 -%}
          <div class="product-grid">
            {%- for product in products -%}{%- render 'product-card', product: product -%}{%- endfor -%}
          </div>
        {%- endif -%}
        {%- if others.size > 0 -%}
          <div class="srch__other">
            <h2 class="h3">Pages &amp; articles</h2>
            <ul>
              {%- for item in others -%}
                <li><a href="{{ item.url }}">{{ item.title }}</a>{% if item.object_type == 'article' %} <span>Article</span>{% endif %}</li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}
        {%- render 'pagination', paginate: paginate -%}
      {%- endpaginate -%}
    </div>
  {%- endif -%}
</section>

{% stylesheet %}
  .srch { background: var(--cream); }
  .srch__form { display: flex; width: 100%; max-width: 560px; margin: 8px 0 16px; }
  .srch__form .input { flex: 1; border-right: 0; }
  .srch__results { max-width: var(--page-max); margin: 0 auto; padding: 16px var(--gutter) var(--section-pad); }
  .srch__empty { text-align: center; color: var(--body); padding: 20px 0 40px; }
  .srch__empty a { color: var(--gold-dark); border-bottom: 1px solid var(--gold-2); }
  .srch__other { margin-top: 56px; }
  .srch__other h2 { margin-bottom: 16px; }
  .srch__other ul { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 10px; }
  .srch__other a { color: var(--ink); border-bottom: 1px solid var(--gold-2); }
  .srch__other span { font-size: 11px; letter-spacing: .16em; text-transform: uppercase; color: var(--muted); margin-left: 10px; }
{% endstylesheet %}

{% schema %}
{
  "name": "Search page",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Search" },
    { "type": "text", "id": "placeholder", "label": "Placeholder", "default": "Search rings, brands, watches…" }
  ]
}
{% endschema %}
