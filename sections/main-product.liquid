{%- liquid
  assign s = section.settings
  assign cv = product.selected_or_first_available_variant
  assign on_sale = false
  if cv.compare_at_price > cv.price
    assign on_sale = true
  endif
  assign form_id = 'ProductForm-' | append: section.id
  assign design_number = cv.metafields.custom.design_number_variant
-%}

<section class="full-width pd" data-product-section data-section-id="{{ section.id }}">
  {%- if s.show_breadcrumbs -%}
    <nav class="crumbs pd__crumbs" aria-label="Breadcrumb">
      <a href="{{ routes.root_url }}">Home</a><span>&rsaquo;</span>
      {%- if collection -%}<a href="{{ collection.url }}">{{ collection.title }}</a><span>&rsaquo;</span>{%- endif -%}
      <span class="cur">{{ product.title }}</span>
    </nav>
  {%- endif -%}

  <div class="pd__main">
    <div class="pd__gallery" data-gallery>
      {%- if product.media.size > 1 -%}
        <div class="pd__thumbs" role="list">
          {%- for media in product.media limit: 8 -%}
            {%- if media.media_type == 'image' -%}
              <button type="button" class="pd__thumb{% if forloop.first %} on{% endif %}" data-thumb data-media-id="{{ media.id }}" data-full="{{ media | image_url: width: 1400 }}" aria-label="View image {{ forloop.index }}">
                {{ media | image_url: width: 160 | image_tag: loading: 'lazy', alt: media.alt }}
              </button>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
      <div class="pd__mainimg">
        {%- if product.featured_media -%}
          {{ product.featured_media | image_url: width: 1400 | image_tag: id: 'MainImage', loading: 'eager', alt: product.title, widths: '600, 900, 1200, 1400', sizes: '(max-width: 900px) 100vw, 55vw' }}
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: 'placeholder' }}
        {%- endif -%}
        <span class="pd__badge" data-sale-badge{% unless on_sale %} hidden{% endunless %}>Sale</span>
      </div>
    </div>

    <div class="pd__buy">
      {%- for block in section.blocks -%}
        {%- case block.type -%}

          {%- when 'title' -%}
            <div {{ block.shopify_attributes }}>
              {%- if block.settings.show_location -%}
                {%- if product.tags contains 'Burrows Jewellers' -%}<span class="pd__loc pd__loc--bj">Burrows Jewellers</span>
                {%- elsif product.tags contains 'Jewellery65' -%}<span class="pd__loc pd__loc--j65">Jewellery65</span>
                {%- elsif product.tags contains 'Warehouse' -%}<span class="pd__loc pd__loc--wh">Warehouse</span>{%- endif -%}
              {%- endif -%}
              {%- if block.settings.show_vendor and product.vendor != blank -%}<div class="pd__eyebrow">{{ product.vendor }}</div>{%- endif -%}
              <h1 class="pd__title">{{ product.title }}</h1>
            </div>

          {%- when 'price' -%}
            <div class="pd__pricewrap" {{ block.shopify_attributes }}>
              <div class="pd__priceline">
                <span class="pd__price{% if on_sale %} on{% endif %}" data-price>{{ cv.price | money }}</span>
                <span class="pd__was" data-compare-price{% unless on_sale %} hidden{% endunless %}>{{ cv.compare_at_price | money }}</span>
                {%- if block.settings.gst_note != blank -%}<span class="pd__gst">{{ block.settings.gst_note }}</span>{%- endif -%}
              </div>
              {%- if block.settings.show_afterpay -%}
                <div class="pd__afterpay">or 4 payments of <strong data-afterpay>{{ cv.price | divided_by: 4 | money }}</strong> with Afterpay</div>
              {%- endif -%}
              {%- if block.settings.show_design_number -%}
                <div class="pd__design" data-design-number-wrap{% if design_number == blank %} hidden{% endif %}>Design number: <span data-design-number>{{ design_number }}</span></div>
              {%- endif -%}
            </div>

          {%- when 'text' -%}
            <div class="pd__text rte" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>

          {%- when 'variant_picker' -%}
            {%- unless product.has_only_default_variant -%}
              <div class="pd__options" {{ block.shopify_attributes }} data-variant-picker>
                {%- for option in product.options_with_values -%}
                  <fieldset class="pd__opt" data-option-index="{{ forloop.index0 }}">
                    <legend class="pd__opt-label">{{ option.name }} &mdash; <b data-option-selected>{{ option.selected_value }}</b></legend>
                    <div class="pd__vals">
                      {%- for value in option.values -%}
                        {%- assign oid = section.id | append: '-' | append: forloop.parentloop.index0 | append: '-' | append: forloop.index0 -%}
                        <input type="radio" class="visually-hidden pd__radio" id="opt-{{ oid }}" name="opt-{{ section.id }}-{{ forloop.parentloop.index0 }}" value="{{ value | escape }}" form="{{ form_id }}" {% if value == option.selected_value %}checked{% endif %}>
                        <label for="opt-{{ oid }}">{{ value }}</label>
                      {%- endfor -%}
                    </div>
                    {%- if block.settings.size_note != blank -%}
                      {%- assign oname = option.name | downcase -%}
                      {%- if oname contains 'size' -%}<div class="pd__note">{{ block.settings.size_note }}</div>{%- endif -%}
                    {%- endif -%}
                  </fieldset>
                {%- endfor -%}
              </div>
            {%- endunless -%}

          {%- when 'ring_sizing' -%}
            {%- liquid
              assign rs = block.settings
              assign resize_product = rs.resize_product
              assign product_size = product.metafields.custom.ring_size_product | metafield_text
              assign product_metal = product.metafields.custom.metal_type_product | metafield_text
            -%}
            <div class="pd__sizing" data-sizing data-steps="{{ rs.steps }}" data-prefixes="{{ rs.prefixes | escape }}" data-label="{{ rs.label | escape }}" hidden {{ block.shopify_attributes }}>
              <fieldset class="pd__opt">
                <legend class="pd__opt-label">{{ rs.label }} &mdash; <b data-sizing-current></b></legend>
                <div class="pd__vals pd__vals--sizing" data-sizing-vals></div>
                <div class="pd__sizing-summary" data-sizing-summary></div>
                {%- if rs.note != blank -%}<div class="pd__note" data-sizing-note hidden>{{ rs.note }}</div>{%- endif -%}
              </fieldset>
            </div>
            {%- if rs.contact_text != blank -%}
              <div class="pd__sizing-contact" data-sizing-contact hidden>
                <a href="{{ rs.contact_url | default: '/pages/contact' }}">{{ rs.contact_text }}</a>
              </div>
            {%- endif -%}
            <script type="application/json" data-sizing-map>{
              "variants": { {%- for v in product.variants -%}"{{ v.id }}": { "sku": {{ v.sku | json }}, "size": {{ v.metafields.custom.ring_size_variant | metafield_text | default: product_size | json }}, "metal": {{ v.metafields.custom.metal_type | metafield_text | default: product_metal | json }} }{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%} },
              "resize": [ {%- for rv in resize_product.variants -%}{ "id": {{ rv.id }}, "title": {{ rv.title | json }}, "price": {{ rv.price }} }{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%} ],
              "productTitle": {{ product.title | json }}
            }</script>

          {%- when 'buy_buttons' -%}
            <div {{ block.shopify_attributes }}>
              {%- form 'product', product, id: form_id, class: 'pd__form', novalidate: 'novalidate' -%}
                <input type="hidden" name="id" value="{{ cv.id }}" data-variant-id>
                <div class="pd__cartrow">
                  {%- if block.settings.show_quantity -%}
                    <div class="pd__qty">
                      <button type="button" data-qty-minus aria-label="Decrease quantity">&minus;</button>
                      <input type="number" name="quantity" value="1" min="1" aria-label="Quantity" data-qty>
                      <button type="button" data-qty-plus aria-label="Increase quantity">+</button>
                    </div>
                  {%- endif -%}
                  <button type="submit" class="pd__add" data-add-button {% unless cv.available %}disabled{% endunless %}>
                    <span data-add-label>{% if cv.available %}{{ block.settings.label }}{% else %}Sold out{% endif %}</span>
                  </button>
                </div>
                {%- if block.settings.show_dynamic_checkout -%}
                  <div class="pd__dynamic">{{ form | payment_button }}</div>
                {%- endif -%}
              {%- endform -%}
            </div>

          {%- when 'phone_order' -%}
            <div class="pd__phoneorder" {{ block.shopify_attributes }}>
              {%- if block.settings.text != blank -%}<p>{{ block.settings.text }}</p>{%- endif -%}
              <div class="actions actions--tight">
                <a class="btn btn--gold" href="tel:{{ settings.store_phone_tel }}">{{ block.settings.phone_label }} {{ settings.store_phone_display }}</a>
                <a class="btn btn--outline-dark" href="{{ block.settings.contact_url | default: '/pages/contact' }}">{{ block.settings.contact_label }}</a>
              </div>
            </div>

          {%- when 'add_diamond' -%}
            <a class="btn btn--ink pd__adddiamond" data-add-diamond data-base="{{ block.settings.builder_url | default: '/pages/ring-builder' }}" href="{{ block.settings.builder_url | default: '/pages/ring-builder' }}?stage=Add+Diamond&settingId={{ product.id }}&settingVariantId={{ cv.id }}" {{ block.shopify_attributes }}>{{ block.settings.label }}</a>

          {%- when 'pickup' -%}
            <div class="pd__pickup" data-pickup {{ block.shopify_attributes }}>
              {%- render 'pickup-status', variant: cv -%}
            </div>

          {%- when 'booking' -%}
            {%- if settings.booking_url != blank -%}
              <a class="pd__viewing" href="{{ settings.booking_url }}" target="_blank" rel="noopener" {{ block.shopify_attributes }}>{{ block.settings.label }}</a>
            {%- endif -%}

          {%- when 'trust_strip' -%}
            <div class="pd__strip" {{ block.shopify_attributes }}>
              {%- if block.settings.item_1 != blank -%}<div><span></span>{{ block.settings.item_1 }}</div>{%- endif -%}
              {%- if block.settings.item_2 != blank -%}<div><span></span>{{ block.settings.item_2 }}</div>{%- endif -%}
              {%- if block.settings.item_3 != blank -%}<div><span></span>{{ block.settings.item_3 }}</div>{%- endif -%}
              {%- if block.settings.item_4 != blank -%}<div><span></span>{{ block.settings.item_4 }}</div>{%- endif -%}
            </div>

          {%- when 'description' -%}
            {%- if product.description != blank -%}
              <details class="acc" {{ block.shopify_attributes }}{% if block.settings.open %} open{% endif %}>
                <summary>{{ block.settings.heading }}<span class="pm"></span></summary>
                <div class="acc__body rte">{{ product.description }}</div>
              </details>
            {%- endif -%}

          {%- when 'specs' -%}
            <details class="acc" {{ block.shopify_attributes }}>
              <summary>{{ block.settings.heading }}<span class="pm"></span></summary>
              <div class="acc__body">
                <ul class="pd__specs">
                  {%- if product.type != blank -%}<li><span>Type</span>{{ product.type }}</li>{%- endif -%}
                  {%- if product.vendor != blank -%}<li><span>Brand</span>{{ product.vendor }}</li>{%- endif -%}
                  {%- if product.metafields.custom.s_metal_type_product != blank -%}<li><span>Metal</span>{{ product.metafields.custom.s_metal_type_product | metafield_text }}</li>{%- endif -%}
                  {%- if product.metafields.custom.s_stone_type_product != blank -%}<li><span>Stone</span>{{ product.metafields.custom.s_stone_type_product | metafield_text }}</li>{%- endif -%}
                  {%- if product.metafields.custom.s_cat__product != blank -%}<li><span>Category</span>{{ product.metafields.custom.s_cat__product | metafield_text }}</li>{%- endif -%}
                  {%- if product.metafields.custom.s_sub_cat__product != blank -%}<li><span>Style</span>{{ product.metafields.custom.s_sub_cat__product | metafield_text }}</li>{%- endif -%}
                  <li data-sku-row{% if cv.sku == blank %} hidden{% endif %}><span>SKU</span><em data-sku>{{ cv.sku }}</em></li>
                  <li data-design-row{% if design_number == blank %} hidden{% endif %}><span>Design no.</span><em data-design-number>{{ design_number }}</em></li>
                </ul>
              </div>
            </details>

          {%- when 'accordion' -%}
            <details class="acc" {{ block.shopify_attributes }}>
              <summary>{{ block.settings.heading }}<span class="pm"></span></summary>
              <div class="acc__body rte">{{ block.settings.text }}</div>
            </details>

          {%- when 'workshop' -%}
            <div class="pd__work" {{ block.shopify_attributes }}>
              <span class="d"></span>
              <div>
                <div class="t">{{ block.settings.heading }}</div>
                <p>{{ block.settings.text }}</p>
              </div>
            </div>

          {%- when '@app' -%}
            <div class="pd__app" {{ block.shopify_attributes }}>{% render block %}</div>

        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>

  {%- if s.show_sticky -%}
    <div class="pd__sticky" data-sticky>
      <div class="info"><small>{{ product.title | truncatewords: 4 }}</small><b data-sticky-price>{{ cv.price | money }}</b></div>
      <button type="button" data-sticky-add {% unless cv.available %}disabled{% endunless %}>{% if cv.available %}Add to cart{% else %}Sold out{% endif %}</button>
    </div>
  {%- endif -%}

  <script type="application/json" data-product-json>{{ product | json }}</script>
  <script type="application/json" data-design-map>{ {%- for v in product.variants -%}"{{ v.id }}": {{ v.metafields.custom.design_number_variant | default: '' | json }}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%} }</script>
</section>

{% stylesheet %}
  .pd { background: var(--cream); }
  .pd__crumbs { padding: 22px var(--gutter) 0; }
  .pd__main { display: grid; grid-template-columns: 1.15fr 1fr; gap: 64px; padding: 28px var(--gutter) 72px; align-items: start; }
  .pd__gallery { display: flex; gap: 16px; position: sticky; top: calc(var(--header-total, 100px) + 16px); }
  .pd__thumbs { display: flex; flex-direction: column; gap: 12px; }
  .pd__thumb { width: 74px; height: 74px; padding: 0; border: 1px solid rgba(var(--gold-dark-rgb), .25); background: var(--sand); cursor: pointer; overflow: hidden; }
  .pd__thumb img { width: 100%; height: 100%; object-fit: cover; }
  .pd__thumb.on { border: 2px solid var(--gold); }
  .pd__mainimg { position: relative; flex: 1; aspect-ratio: 1; background: var(--sand); overflow: hidden; }
  .pd__mainimg img, .pd__mainimg svg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .pd__badge { position: absolute; top: 14px; left: 14px; background: var(--gold); color: var(--navy); font-size: 10px; letter-spacing: .18em; text-transform: uppercase; font-weight: 600; padding: 5px 10px; }
  .pd__badge[hidden] { display: none; }
  .pd__buy { display: flex; flex-direction: column; max-width: 540px; }
  .pd__loc { display: inline-block; font-size: 9.5px; letter-spacing: .22em; text-transform: uppercase; font-weight: 600; padding: 5px 10px; margin-bottom: 14px; }
  .pd__loc--bj { background: var(--navy); color: var(--gold-2); }
  .pd__loc--j65 { background: #f6d3dd; color: #96324f; }
  .pd__loc--wh { background: #e5d8f2; color: #6b3fa0; }
  .pd__eyebrow { font-size: 11px; letter-spacing: .3em; text-transform: uppercase; color: var(--gold-dark); font-weight: 500; margin-bottom: 12px; }
  .pd__title { font-size: clamp(30px, 3.2vw, 38px); margin: 0 0 14px; line-height: 1.12; }
  .pd__pricewrap { margin-bottom: 24px; }
  .pd__priceline { display: flex; align-items: baseline; gap: 14px; margin-bottom: 6px; flex-wrap: wrap; }
  .pd__price { font-size: 28px; color: var(--ink); font-weight: 500; }
  .pd__price.on { color: #8f2020; }
  .pd__was { font-size: 16px; color: var(--muted); text-decoration: line-through; font-weight: 300; }
  .pd__was[hidden] { display: none; }
  .pd__gst { font-size: 13px; color: var(--muted); font-weight: 300; }
  .pd__afterpay { font-size: 13.5px; color: var(--body); font-weight: 300; }
  .pd__afterpay strong { font-weight: 500; color: var(--ink); }
  .pd__design { font-size: 13px; color: var(--muted); margin-top: 6px; }
  .pd__design[hidden] { display: none; }
  .pd__text { font-size: 14.5px; color: var(--body); margin-bottom: 20px; }
  .pd__options { display: flex; flex-direction: column; gap: 22px; margin-bottom: 22px; }
  .pd__opt { border: 0; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 10px; }
  .pd__opt-label { font-size: 11.5px; letter-spacing: .24em; text-transform: uppercase; color: var(--gold-dark); font-weight: 500; padding: 0; }
  .pd__opt-label b { color: var(--ink); letter-spacing: .05em; text-transform: none; font-size: 13px; font-weight: 400; }
  .pd__vals { display: flex; gap: 8px; flex-wrap: wrap; }
  .pd__vals label { min-width: 44px; height: 44px; padding: 0 12px; display: flex; align-items: center; justify-content: center; border: 1px solid rgba(var(--gold-dark-rgb), .35); font-size: 13.5px; color: var(--body); cursor: pointer; }
  .pd__vals label:hover { border-color: var(--gold); }
  .pd__radio:checked + label { background: var(--ink); border-color: var(--ink); color: var(--cream); font-weight: 500; }
  .pd__radio:focus-visible + label { outline: 2px solid var(--gold); outline-offset: 2px; }
  .pd__vals label.soldout { opacity: .45; text-decoration: line-through; }
  .pd__note { font-size: 12.5px; color: var(--muted); font-weight: 300; }
  .pd__sizing { margin-bottom: 22px; }
  .pd__sizing[hidden], .pd__sizing-contact[hidden], .pd__sizing-summary:empty { display: none; }
  .pd__vals--sizing label { flex-direction: column; gap: 1px; line-height: 1.1; padding: 0 10px; }
  .pd__vals--sizing label small { font-size: 10px; letter-spacing: .04em; color: var(--gold-dark); }
  .pd__radio:checked + label small { color: var(--gold-2); }
  .pd__sizing-summary { font-size: 13px; color: var(--ink); }
  .pd__sizing-summary b { font-weight: 500; }
  .pd__sizing-contact { margin: -8px 0 22px; font-size: 13px; }
  .pd__sizing-contact a { color: var(--gold-dark); border-bottom: 1px solid var(--gold-2); }
  .pd__cartrow { display: flex; gap: 12px; margin-bottom: 14px; }
  .pd__qty { display: flex; align-items: center; border: 1px solid rgba(var(--gold-dark-rgb), .35); }
  .pd__qty button { width: 40px; height: 52px; display: flex; align-items: center; justify-content: center; color: var(--gold-dark); cursor: pointer; font-size: 16px; background: none; border: none; }
  .pd__qty input { width: 38px; text-align: center; font-size: 14px; color: var(--ink); border: none; background: none; -moz-appearance: textfield; border-radius: 0; }
  .pd__qty input::-webkit-outer-spin-button, .pd__qty input::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }
  .pd__add { flex: 1; background: var(--gold); color: var(--navy); font-size: 13px; letter-spacing: .14em; text-transform: uppercase; font-weight: 600; display: flex; align-items: center; justify-content: center; border: none; cursor: pointer; font-family: inherit; min-height: 52px; }
  .pd__add:hover { background: var(--gold-3); }
  .pd__add[disabled] { background: #c9c4b6; color: #6f6f66; cursor: not-allowed; }
  .pd__dynamic { margin-bottom: 14px; }
  .pd__dynamic .shopify-payment-button__button--unbranded { background: var(--ink); color: var(--cream); font-family: var(--font-body); font-size: 13px; letter-spacing: .14em; text-transform: uppercase; font-weight: 500; border-radius: 0; min-height: 52px; }
  .pd__dynamic .shopify-payment-button__button--unbranded:hover { background: var(--navy); }
  .pd__phoneorder { margin-bottom: 20px; }
  .pd__phoneorder p { font-size: 14px; color: var(--body); margin: 0 0 14px; }
  .pd__adddiamond { display: block; text-align: center; margin-bottom: 14px; }
  .pd__pickup { margin: -8px 0 24px; }
  .pd__pickup:empty { display: none; }
  .pu__row { display: flex; gap: 10px; align-items: flex-start; }
  .pu__ok { color: #2f7d32; font-weight: 700; }
  .pu__no { color: #8f2020; font-weight: 700; }
  .pu__line { font-size: 14px; color: var(--body); }
  .pu__line b { color: var(--ink); font-weight: 500; }
  .pu__time { font-size: 12.5px; color: var(--muted); margin-top: 2px; }
  .pu__more { margin: 8px 0 0 24px; }
  .pu__more summary { list-style: none; cursor: pointer; font-size: 12.5px; color: var(--gold-dark); border-bottom: 1px solid var(--gold-2); display: inline; }
  .pu__more summary::-webkit-details-marker { display: none; }
  .pu__more ul { list-style: none; margin: 10px 0 0; padding: 12px 14px; border: 1px solid rgba(var(--gold-dark-rgb), .2); display: flex; flex-direction: column; gap: 6px; font-size: 13px; color: var(--body); }
  .pu__more b { color: var(--ink); font-weight: 500; }
  .pd__viewing { border: 1px solid var(--ink); color: var(--ink); font-size: 13px; letter-spacing: .14em; text-transform: uppercase; font-weight: 500; padding: 15px; text-align: center; margin-bottom: 26px; display: block; }
  .pd__viewing:hover { background: var(--ink); color: var(--cream); }
  .pd__strip { display: grid; grid-template-columns: 1fr 1fr; gap: 12px 20px; padding: 20px 0; border-top: 1px solid rgba(var(--gold-dark-rgb), .18); border-bottom: 1px solid rgba(var(--gold-dark-rgb), .18); margin-bottom: 26px; }
  .pd__strip div { display: flex; align-items: center; gap: 9px; font-size: 12.5px; color: var(--body); font-weight: 300; }
  .pd__strip span { width: 5px; height: 5px; background: var(--gold); transform: rotate(45deg); flex: none; }
  .pd__specs { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 8px; }
  .pd__specs li { display: flex; gap: 16px; }
  .pd__specs li[hidden] { display: none; }
  .pd__specs span { min-width: 100px; font-size: 11px; letter-spacing: .18em; text-transform: uppercase; color: var(--gold-dark); font-weight: 500; padding-top: 3px; }
  .pd__specs em { font-style: normal; }
  .pd__work { background: var(--navy-2); padding: 24px 26px; margin-top: 26px; display: flex; gap: 18px; align-items: flex-start; }
  .pd__work .d { width: 7px; height: 7px; background: var(--gold); transform: rotate(45deg); margin-top: 7px; flex: none; }
  .pd__work .t { font-family: var(--font-heading); font-size: 21px; color: var(--cream); font-weight: 500; margin-bottom: 6px; }
  .pd__work p { font-size: 13.5px; line-height: 1.7; color: rgba(var(--cream-rgb), .6); font-weight: 300; margin: 0; }
  .pd__app { margin-bottom: 16px; }
  .pd__sticky { position: fixed; bottom: 0; left: 0; right: 0; z-index: 900; background: var(--navy); padding: 10px 16px; display: none; align-items: center; gap: 14px; box-shadow: 0 -4px 18px rgba(var(--navy-rgb), .35); }
  .pd__sticky .info { display: flex; flex-direction: column; }
  .pd__sticky .info small { font-size: 11px; color: rgba(var(--cream-rgb), .55); }
  .pd__sticky .info b { font-size: 14px; color: var(--cream); font-weight: 500; }
  .pd__sticky button { margin-left: auto; background: var(--gold); color: var(--navy); font-size: 11.5px; letter-spacing: .12em; text-transform: uppercase; font-weight: 600; padding: 12px 18px; border: none; cursor: pointer; }
  .pd__sticky button[disabled] { background: #c9c4b6; color: #6f6f66; }
  @media (max-width: 900px) {
    .pd__main { grid-template-columns: 1fr; gap: 32px; padding: 20px var(--gutter-mobile) 40px; }
    .pd__gallery { position: static; flex-direction: column-reverse; }
    .pd__thumbs { flex-direction: row; overflow-x: auto; }
    .pd__thumb { flex: none; width: 64px; height: 64px; }
    .pd__crumbs { padding: 16px var(--gutter-mobile) 0; }
    .pd__buy { max-width: none; }
    .pd__sticky { display: flex; }
    .pd { padding-bottom: 74px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Product page",
  "settings": [
    { "type": "checkbox", "id": "show_breadcrumbs", "label": "Show breadcrumbs", "default": true },
    { "type": "checkbox", "id": "show_sticky", "label": "Sticky add-to-cart bar on mobile", "default": true }
  ],
  "blocks": [
    { "type": "title", "name": "Title", "limit": 1, "settings": [
      { "type": "checkbox", "id": "show_vendor", "label": "Show brand above title", "default": true },
      { "type": "checkbox", "id": "show_location", "label": "Show stock location badge", "default": true, "info": "Reads the Burrows Jewellers / Jewellery65 / Warehouse tag kept up to date nightly from inventory." }
    ] },
    { "type": "price", "name": "Price", "limit": 1, "settings": [
      { "type": "text", "id": "gst_note", "label": "Note beside price", "default": "AUD · incl. GST" },
      { "type": "checkbox", "id": "show_afterpay", "label": "Show 4 payments with Afterpay line", "default": true, "info": "Turn off if you add the Afterpay app block instead." },
      { "type": "checkbox", "id": "show_design_number", "label": "Show design number (variant metafield custom.design_number_variant)", "default": true }
    ] },
    { "type": "text", "name": "Text", "settings": [ { "type": "richtext", "id": "text", "label": "Text", "default": "<p>This product will be shipped directly from our warehouse.</p>" } ] },
    { "type": "variant_picker", "name": "Variant picker", "limit": 1, "settings": [ { "type": "text", "id": "size_note", "label": "Note under size options", "default": "Sized and finished in our Mildura workshop." } ] },
    { "type": "ring_sizing", "name": "Ring size / resizing", "limit": 1, "settings": [
      { "type": "paragraph", "content": "Shows a ring-size picker on rings whose SKU starts with one of the department prefixes. The ring's own size comes from the variant metafield custom.ring_size_variant (or custom.ring_size_product); the metal from custom.metal_type. Choosing a different size adds the matching variant of the resizing product to the cart." },
      { "type": "product", "id": "resize_product", "label": "Resizing product", "info": "Its variants are matched to the ring's metal by carat (e.g. a \"9ct gold\" variant is used for rings tagged 9k)." },
      { "type": "text", "id": "prefixes", "label": "SKU prefixes (comma separated)", "default": "001,002,004" },
      { "type": "range", "id": "steps", "label": "Half-sizes offered each way", "min": 1, "max": 6, "step": 1, "default": 2 },
      { "type": "text", "id": "label", "label": "Label", "default": "Ring size" },
      { "type": "text", "id": "note", "label": "Note when a different size is chosen", "default": "Resized in our Mildura workshop before dispatch — allow 3–5 extra working days." },
      { "type": "text", "id": "contact_text", "label": "Fallback text (no size on file, or other metal)", "default": "Need a different size? Contact us about sizing." },
      { "type": "url", "id": "contact_url", "label": "Fallback link" }
    ] },
    { "type": "buy_buttons", "name": "Buy buttons", "limit": 1, "settings": [
      { "type": "text", "id": "label", "label": "Add to cart label", "default": "Add to Cart" },
      { "type": "checkbox", "id": "show_quantity", "label": "Show quantity selector", "default": true },
      { "type": "checkbox", "id": "show_dynamic_checkout", "label": "Show dynamic checkout button (Shop Pay, PayPal…)", "default": false }
    ] },
    { "type": "phone_order", "name": "Phone order only", "limit": 1, "settings": [
      { "type": "textarea", "id": "text", "label": "Text", "default": "This piece is available by phone order or in store." },
      { "type": "text", "id": "phone_label", "label": "Phone button label", "default": "Call" },
      { "type": "text", "id": "contact_label", "label": "Contact button label", "default": "Contact us" },
      { "type": "url", "id": "contact_url", "label": "Contact link" }
    ] },
    { "type": "add_diamond", "name": "Add diamond button", "limit": 1, "settings": [
      { "type": "text", "id": "label", "label": "Label", "default": "Add a diamond to this setting" },
      { "type": "url", "id": "builder_url", "label": "Ring builder page" }
    ] },
    { "type": "pickup", "name": "Pickup availability", "limit": 1, "settings": [ { "type": "paragraph", "content": "Shows Shopify's local pickup availability for the selected variant (locations with Local Pickup enabled — Burrows Jewellers and Jewellery65)." } ] },
    { "type": "booking", "name": "Book a viewing link", "limit": 1, "settings": [ { "type": "text", "id": "label", "label": "Label", "default": "Book a viewing in store" } ] },
    { "type": "trust_strip", "name": "Trust strip", "limit": 1, "settings": [
      { "type": "text", "id": "item_1", "label": "Item 1", "default": "Free AU shipping over $99" },
      { "type": "text", "id": "item_2", "label": "Item 2", "default": "On-site workshop" },
      { "type": "text", "id": "item_3", "label": "Item 3", "default": "Serviced & resized in Mildura" },
      { "type": "text", "id": "item_4", "label": "Item 4", "default": "Afterpay & Zip available" }
    ] },
    { "type": "description", "name": "Description", "limit": 1, "settings": [
      { "type": "text", "id": "heading", "label": "Heading", "default": "Description" },
      { "type": "checkbox", "id": "open", "label": "Open by default", "default": true }
    ] },
    { "type": "specs", "name": "Specifications", "limit": 1, "settings": [ { "type": "text", "id": "heading", "label": "Heading", "default": "Specifications" } ] },
    { "type": "accordion", "name": "Accordion (custom)", "settings": [
      { "type": "text", "id": "heading", "label": "Heading", "default": "Shipping details" },
      { "type": "richtext", "id": "text", "label": "Text", "default": "<ul><li>Burrows Jewellers currently ships within Australia only.</li><li>Orders over $99 free shipping; over $250 free express shipping; under $99 a $5 fee.</li><li>Items are generally shipped within 1–3 business days. If your order is delayed we will contact you by phone or email.</li></ul>" }
    ] },
    { "type": "workshop", "name": "Workshop panel", "limit": 1, "settings": [
      { "type": "text", "id": "heading", "label": "Heading", "default": "Made for life in our Mildura workshop" },
      { "type": "textarea", "id": "text", "label": "Text", "default": "Every piece we sell is cleaned, checked, resized and repaired at our own bench on Langtree Ave — never sent away." }
    ] },
    { "type": "@app" }
  ]
}
{% endschema %}
