{%- assign s = section.settings -%}
<section class="full-width ic bg-{{ s.background }}">
  <div class="container">
    {%- if s.eyebrow != blank or s.heading != blank -%}
      <div class="section-head">
        {%- if s.eyebrow != blank -%}<span class="eyebrow">{{ s.eyebrow }}</span>{%- endif -%}
        {%- if s.heading != blank -%}<h2 class="h2">{{ s.heading }}</h2>{%- endif -%}
      </div>
    {%- endif -%}
    <div class="ic__grid ic__grid--{{ s.columns }} ic__grid--{{ s.ratio }}">
      {%- for block in section.blocks -%}
        {%- liquid
          assign b = block.settings
          assign href = b.url
          if href == blank and b.collection != blank
            assign href = b.collection.url
          endif
          assign title = b.title
          if title == blank and b.collection != blank
            assign title = b.collection.title
          endif
          assign img = b.image
          if img == blank and b.collection != blank
            assign img = b.collection.featured_image
          endif
        -%}
        <div class="ic__card" {{ block.shopify_attributes }}>
          {%- if href != blank -%}<a class="ic__media" href="{{ href }}" aria-label="{{ title | escape }}">{%- else -%}<div class="ic__media">{%- endif -%}
            {%- if img != blank -%}
              {{ img | image_url: width: 900 | image_tag: loading: 'lazy', alt: title, widths: '400, 600, 900' }}
            {%- elsif b.image_url != blank -%}
              <img src="{{ b.image_url }}" alt="{{ title | escape }}" loading="lazy" width="900" height="900">
            {%- else -%}
              {{ 'collection-1' | placeholder_svg_tag: 'placeholder' }}
            {%- endif -%}
          {%- if href != blank -%}</a>{%- else -%}</div>{%- endif -%}
          <div class="ic__body">
            {%- if title != blank -%}<h3 class="ic__title">{% if href != blank %}<a href="{{ href }}">{{ title }}</a>{% else %}{{ title }}{% endif %}</h3>{%- endif -%}
            {%- if b.text != blank -%}<div class="ic__text rte">{{ b.text }}</div>{%- endif -%}
            {%- if b.button_label != blank and href != blank -%}<a class="link-gold" href="{{ href }}">{{ b.button_label }}</a>{%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .ic { padding: var(--section-pad) var(--gutter); }
  .ic__grid { display: grid; gap: 40px 28px; }
  .ic__grid--2 { grid-template-columns: repeat(2, 1fr); }
  .ic__grid--3 { grid-template-columns: repeat(3, 1fr); }
  .ic__grid--4 { grid-template-columns: repeat(4, 1fr); }
  .ic__card { display: flex; flex-direction: column; gap: 16px; text-align: center; }
  .ic__media { position: relative; aspect-ratio: 4 / 3; background: var(--sand); overflow: hidden; display: block; }
  .ic__grid--square .ic__media { aspect-ratio: 1; }
  .ic__grid--portrait .ic__media { aspect-ratio: 3 / 4; }
  .ic__media img, .ic__media svg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform .6s; }
  .ic__card:hover .ic__media img { transform: scale(1.04); }
  .ic__body { display: flex; flex-direction: column; gap: 10px; align-items: center; }
  .ic__title { font-size: 24px; }
  .ic__title a:hover { color: var(--gold-dark); }
  .ic__text { font-size: 14.5px; line-height: 1.7; color: var(--body); font-weight: 300; }
  @media (max-width: 1023px) {
    .ic__grid--3, .ic__grid--4 { grid-template-columns: repeat(2, 1fr); gap: 28px 16px; }
  }
  @media (max-width: 600px) {
    .ic__grid--2, .ic__grid--3, .ic__grid--4 { grid-template-columns: 1fr 1fr; }
    .ic__title { font-size: 20px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Image cards",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "select", "id": "columns", "label": "Columns", "options": [ { "value": "2", "label": "2" }, { "value": "3", "label": "3" }, { "value": "4", "label": "4" } ], "default": "3" },
    { "type": "select", "id": "ratio", "label": "Image shape", "options": [ { "value": "landscape", "label": "Landscape" }, { "value": "square", "label": "Square" }, { "value": "portrait", "label": "Portrait" } ], "default": "landscape" },
    { "type": "select", "id": "background", "label": "Background", "options": [ { "value": "cream", "label": "Cream" }, { "value": "sand", "label": "Sand" } ], "default": "cream" }
  ],
  "blocks": [
    { "type": "card", "name": "Card", "settings": [
      { "type": "image_picker", "id": "image", "label": "Image" },
      { "type": "text", "id": "image_url", "label": "Image URL fallback" },
      { "type": "collection", "id": "collection", "label": "Collection (fills title, image and link if left blank)" },
      { "type": "text", "id": "title", "label": "Title" },
      { "type": "richtext", "id": "text", "label": "Text" },
      { "type": "text", "id": "button_label", "label": "Link label" },
      { "type": "url", "id": "url", "label": "Link" }
    ] }
  ],
  "max_blocks": 24,
  "presets": [{ "name": "Image cards", "blocks": [ { "type": "card" }, { "type": "card" }, { "type": "card" } ] }]
}
{% endschema %}
