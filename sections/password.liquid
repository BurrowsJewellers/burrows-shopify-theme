{%- liquid
  assign logo_url = 'logo-white.png' | asset_url
  if settings.logo_light != blank
    assign logo_url = settings.logo_light | image_url: width: 600
  elsif settings.logo_light_url != blank
    assign logo_url = settings.logo_light_url
  endif
-%}
<section class="full-width pw on-dark">
  <img class="pw__logo" src="{{ logo_url }}" alt="{{ shop.name | escape }}" width="220" height="76">
  <h1 class="h2">{{ section.settings.heading }}</h1>
  {%- if shop.password_message != blank -%}<p class="pw__msg">{{ shop.password_message }}</p>{%- endif -%}
  {%- form 'storefront_password', class: 'pw__form' -%}
    {%- if form.errors -%}<div class="form-errors">{{ form.errors | default_errors }}</div>{%- endif -%}
    <label class="visually-hidden" for="Password">Password</label>
    <div class="pw__row">
      <input class="input" id="Password" type="password" name="password" placeholder="Password" autocomplete="current-password">
      <button class="btn btn--gold" type="submit">Enter</button>
    </div>
  {%- endform -%}
  <p class="pw__foot">{{ settings.store_address_line }} &middot; <a href="tel:{{ settings.store_phone_tel }}">{{ settings.store_phone_display }}</a></p>
</section>

{% stylesheet %}
  .pw { min-height: 100vh; background: var(--navy); display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; padding: 60px var(--gutter); gap: 20px; }
  .pw__logo { height: 76px; width: auto; }
  .pw__msg { color: rgba(var(--cream-rgb), .75); max-width: 520px; }
  .pw__row { display: flex; width: 100%; max-width: 420px; }
  .pw__row .input { flex: 1; border-right: 0; }
  .pw__foot { font-size: 13px; color: rgba(var(--cream-rgb), .5); }
  .pw__foot a { color: var(--gold-2); }
{% endstylesheet %}

{% schema %}
{
  "name": "Password page",
  "settings": [ { "type": "text", "id": "heading", "label": "Heading", "default": "Something new is on the way" } ]
}
{% endschema %}
