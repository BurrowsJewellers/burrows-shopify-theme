{% doc %}
  Keeps heading levels sane inside editor-authored HTML (page bodies, product descriptions,
  article bodies, rich-text blocks) so every page has exactly one H1 and no skipped levels.
  - Any H1 in body content becomes an H2 (the page's own title is the H1).
  - H4/H5/H6 become H3 when the content already uses H2, otherwise H2 — so nothing jumps
    from H1 or H2 straight to H4 (the supplier feeds write "Product Description:" as H6).
  Visual size is kept with a class matching the original tag.
  @param {string} html - the HTML to normalise
{% enddoc %}
{%- liquid
  assign out = html
  if out contains '<h1' or out contains '<H1'
    assign out = out | replace: '<h1>', '<h2 class="h1">' | replace: '<h1 ', '<h2 class="h1" ' | replace: '</h1>', '</h2>' | replace: '<H1>', '<h2 class="h1">' | replace: '</H1>', '</h2>'
  endif
  assign low = 'h3'
  unless out contains '<h2' or out contains '<H2'
    assign low = 'h2'
  endunless
  assign close_tag = '</' | append: low | append: '>'
  assign o4 = '<' | append: low | append: ' class="h4">'
  assign o4a = '<' | append: low | append: ' class="h4" '
  assign o5 = '<' | append: low | append: ' class="h5">'
  assign o5a = '<' | append: low | append: ' class="h5" '
  assign o6 = '<' | append: low | append: ' class="h6">'
  assign o6a = '<' | append: low | append: ' class="h6" '
  assign out = out | replace: '<h4>', o4 | replace: '<h4 ', o4a | replace: '</h4>', close_tag | replace: '<H4>', o4 | replace: '</H4>', close_tag
  assign out = out | replace: '<h5>', o5 | replace: '<h5 ', o5a | replace: '</h5>', close_tag | replace: '<H5>', o5 | replace: '</H5>', close_tag
  assign out = out | replace: '<h6>', o6 | replace: '<h6 ', o6a | replace: '</h6>', close_tag | replace: '<H6>', o6 | replace: '</H6>', close_tag
  echo out
-%}
